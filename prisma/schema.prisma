// Prisma schema for My Biz Flow.
//
// Each model here is the documented migration target for one of the
// JSON-file-backed Designer stores under src/lib/designer/ and
// src/lib/errorLog.ts — see each store's file header for the "migrate to
// a Prisma table with identical function signatures" note this schema
// fulfills. Table/column names below intentionally mirror each store's
// existing JSON shape so the migration is a mechanical fs -> db swap, not
// a redesign.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (via Neon's PgBouncer endpoint) for normal app
  // queries — see Vercel's Neon integration, which sets this automatically.
  url       = env("DATABASE_URL")
  // Direct (unpooled) connection — Prisma only reads `directUrl` for
  // `migrate dev`'s shadow database, NOT for `migrate deploy` (a common
  // Prisma/Neon gotcha: this field alone does NOT fix migrate deploy
  // against a pooled URL, despite looking like it should). `migrate
  // deploy` always connects with `url` and needs a session-mode
  // connection to acquire its advisory lock — PgBouncer's transaction-
  // mode pooling doesn't support that, and the lock acquisition can hang/
  // timeout (confirmed: a real production deploy failed this way on
  // 2026-09-18). The actual fix is in package.json's `build` script,
  // which overrides DATABASE_URL to this unpooled value for the
  // `prisma migrate deploy` step specifically, then leaves it pooled
  // again for `next build`/runtime.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/// Mirrors data/customizations.json — keyed by pageId (src/lib/designer/customizations.ts).
model PageCustomization {
  pageId           String   @id
  fieldOverrides   Json     @default("{}")
  addedFields      Json     @default("[]")
  deletedFieldKeys Json     @default("[]")
  optionOverrides  Json     @default("{}")
  updatedAt        DateTime @updatedAt

  @@map("page_customizations")
}

/// Mirrors data/document-templates.json — keyed by pageId (src/lib/designer/documentTemplates.ts).
model DocumentTemplate {
  pageId       String   @id
  htmlTemplate String   @db.Text
  updatedAt    DateTime @updatedAt

  @@map("document_templates")
}

/// Mirrors data/module-appearance.json — keyed by module slug (src/lib/designer/moduleAppearance.ts).
model ModuleAppearance {
  slug      String   @id
  label     String?
  icon      String?
  updatedAt DateTime @updatedAt

  @@map("module_appearances")
}

/// Mirrors data/numbering.json's `main` map — one row per document type (src/lib/designer/numbering.ts).
model NumberingMainScheme {
  documentType String @id
  scheme       Json

  @@map("numbering_main_schemes")
}

/// Mirrors data/numbering.json's `partner` map — one row per (partnerId, documentType) override.
model NumberingPartnerScheme {
  partnerId    String
  documentType String
  scheme       Json

  @@id([partnerId, documentType])
  @@map("numbering_partner_schemes")
}

/// Mirrors data/numbering.json's `counters` map — one row per scopeKey ("main:<type>" or "partner:<id>:<type>").
model NumberingCounter {
  scopeKey String @id
  value    Int

  @@map("numbering_counters")
}

/// Singleton row (id is always "platform") holding platform-ops config that
/// used to live only in env vars — currently the two Telegram group chat
/// IDs: one for business-facing ops notifications (signups, bookings,
/// support tickets — previously TELEGRAM_OPS_CHAT_ID only), one for
/// application error alerts (new — see src/lib/errorLog.ts). Editable from
/// the separate My-Biz-Flow-Admin app against this same physical DB; either
/// field falling back to its env var when unset (see src/lib/platformSettings.ts).
model PlatformSettings {
  id                       String  @id @default("platform")
  opsChatId                String?
  errorChatId              String?
  /// Which WhatsApp automated-message trigger points are turned on,
  /// platform-wide — a JSON string array of trigger keys (e.g.
  /// ["telecalling.leadAccepted"]), edited from the separate
  /// My-Biz-Flow-Admin app against this same physical DB. Absence of a key
  /// means that trigger is off — see src/lib/whatsappTriggers.ts. Kept as
  /// one extensible list rather than a boolean-per-trigger column so a new
  /// trigger point can be added in code and toggled on from Admin without
  /// a schema migration each time.
  enabledWhatsappTriggers  Json    @default("[]")
  /// Per-cadence last-sent stamp for the platform's own growth digest (see
  /// src/lib/platformReportData.ts) — same {DAILY?, WEEKLY?, MONTHLY?} ISO
  /// map shape as TelegramSettings.lastReportSentAt, just platform-scoped
  /// instead of per-partner, since there's only ever one "platform".
  lastPlatformReportSentAt Json    @default("{}")

  @@map("platform_settings")
}

/// Mirrors data/page-access.json — pageId -> isPublic (src/lib/designer/pageAccess.ts).
/// Only rows for pages actually marked public are stored (absence = private),
/// same as the JSON store's "delete key when false" convention.
model PageAccess {
  pageId   String  @id
  isPublic Boolean @default(true)

  @@map("page_access")
}

/// Mirrors data/error-log.json (src/lib/errorLog.ts).
model ErrorLogEntry {
  id        String   @id
  timestamp DateTime @default(now())
  message   String   @db.Text
  stack     String?  @db.Text
  source    String
  severity  String

  @@index([timestamp])
  @@map("error_log_entries")
}

/// Platform-level RBAC, defined once by Super Admin and reused across
/// every partner — see src/lib/designer/accessGroupsData.ts.
/// pagePermissions: PagePermission[] JSON, {pageId, view, edit, delete, other}.
model AccessGroup {
  id              String   @id
  description     String?  @db.Text
  pagePermissions Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("access_groups")
}

/// A named bundle of Access Group ids — see src/lib/designer/rolesData.ts.
model Role {
  id             String   @id
  description    String?  @db.Text
  accessGroupIds Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("roles")
}

/// The top-level entity a partner account is created against — see
/// src/lib/designer/partnerTypesData.ts. defaultModules/assignableRoleIds
/// are JSON string arrays (module slugs / Role ids). planTierByPage is a
/// JSON map of pageId -> "basic" | "pro" | "ultimate", scoped to ONLY this
/// type's own defaultModules pages — every Partner Type defines its own
/// Basic/Pro/Ultimate PAGE breakdown independently (confirmed 2026-08-08:
/// no type may just "include" one of a shared set of plans for page
/// access). planIds (added 2026-08-08) is a separate concern: which of
/// the 3 real Plan price points (src/lib/plansData.ts) this type bundles
/// for actual billing — a type can offer Basic+Pro pricing while still
/// defining its own Basic/Pro page split above.
model PartnerType {
  id                String   @id
  description       String?  @db.Text
  defaultModules    Json     @default("[]")
  assignableRoleIds Json     @default("[]")
  planTierByPage    Json     @default("{}")
  planIds           Json     @default("[]")
  /// Prefix used when generating this PartnerType's Partner.id values (e.g.
  /// "VND" -> VND0001, VND0002, ...; "SC" -> SC0001, SC0002, ...). Each
  /// distinct prefix gets its own independent sequence, counted only over
  /// existing partners sharing that same prefix (see src/lib/partnerData.ts).
  /// Defaults to "VND" so every PartnerType created before this column
  /// existed keeps behaving exactly as before.
  idPrefix          String   @default("VND")
  /// When true, a signup against this type creates a PartnerSignupRequest
  /// instead of a Partner directly — no id is assigned until Super
  /// Admin approves it. Off by default (confirmed 2026-08-08: no approval
  /// required unless explicitly turned on per type).
  requiresApproval  Boolean  @default(false)
  status            String   @default("Active")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("partner_types")
}

/// A registered partner account — see src/lib/partnerData.ts. `id` is the
/// public VND#### id (used for login, invoices, support — everything the
/// partner themselves ever sees). `internalKey` (BIZ<business>-VND####) is
/// for our own DB relations and the eventual central-api sync only, never
/// shown to the partner. businessId is fixed to "BIZ002" (this business's
/// central-api id) until real cross-business support exists.
model Partner {
  id                  String  @id
  internalKey         String  @unique
  businessId          String  @default("BIZ002")
  partnerTypeId       String
  businessName        String
  addressLine         String?
  city                String
  state               String
  pincode             String
  gstin               String?
  /// IANA timezone, e.g. "Asia/Kolkata" — editable from Settings' Business
  /// Details block. Purely a label today (no scheduling/report logic reads
  /// it yet), same status as `currency` below.
  timezone            String  @default("Asia/Kolkata")
  /// Display currency code shown on Settings; actual money formatting
  /// elsewhere in the app is hardcoded to INR (see formatCurrencyINR) —
  /// this does not yet drive that, same caveat as `timezone`.
  currency            String  @default("INR")
  /// Partner-uploaded logo, stored as a `data:` URL. There is no
  /// file-storage/S3 pipeline anywhere in this app yet, so this is the
  /// minimal real option rather than inventing one — see Settings'
  /// Business Details block. Shown in the partner's own sidebar header
  /// and printed documents when set; null renders the app's own logo.
  logoDataUrl         String? @db.Text
  /// Settings' "Show logo on printed documents" toggle — gates whether
  /// `logoDataUrl` is actually printed on customer-facing documents (e.g.
  /// the Service Centre workorder print). Defaults to true so partners who
  /// already uploaded a logo keep seeing it print, same as before this
  /// toggle existed; a partner can turn it off without deleting the logo
  /// itself (which is still used in the sidebar header regardless).
  showLogoOnDocuments Boolean @default(true)
  businessEmail       String
  businessContact     String
  loginContact        String  @unique
  passwordHash        String
  /// True until the partner completes their first forced password change
  /// (signup never collects a password directly — one is generated and
  /// shown/emailed once).
  mustChangePassword  Boolean @default(true)
  status              String  @default("Active")

  /// --- Business profile (editable by the partner from /partner/<id>/settings) ---
  /// Signup only ever collected the bare minimum needed to create an
  /// account; these are the remaining business-detail fields AN-CRM's own
  /// vendor profile page collects (src/app/vendor/profile/page.tsx), so a
  /// partner can complete their profile after the fact. All nullable —
  /// every existing Partner row predates them and none are required to
  /// operate the account.
  contactPerson              String?
  pan                        String?
  businessCategory           String?
  /// Which product domain(s) this partner deals in — a JSON string array of
  /// ProductDomain codes, e.g. ["ELECTRONICS"] or ["ELECTRONICS","AUTOMOBILE"]
  /// (src/lib/catalog/productDomains.ts, which also carries the reasoning
  /// for why this is a Partner-level field rather than a second
  /// PartnerType). Chosen at signup, editable afterwards from
  /// /partner/<id>/settings. Drives which Device Type categories and which
  /// Brand/Model catalog rows the Service Centre module offers. Empty for
  /// every row that predates the column, which reads as ELECTRONICS-only —
  /// what the module has always been.
  productDomains             Json    @default("[]")
  /// Which Service Centre service types this partner offers — a JSON string
  /// array, e.g. ["ONSITE","WALK_IN"] (src/lib/serviceTypes.ts). Drives the
  /// public Book Appointment form (a customer only sees this partner as an
  /// option for a service type they actually offer) and the "Service Type"
  /// field on an Inquiry. Editable from /partner/<id>/settings' Service
  /// Centre tab. Empty reads as "not yet configured" (excluded from
  /// auto-assignment until the partner sets at least one).
  serviceCentreServiceTypes  Json    @default("[]")
  /// Pincodes this partner covers for Service Centre inquiries/appointments
  /// — a JSON string array of 6-digit pincodes, editable from the same
  /// Service Centre settings tab as serviceCentreServiceTypes. Used by the
  /// public Book Appointment form's auto-assignment: pincode match first,
  /// falling back to a partner in the same city/state (see
  /// src/lib/serviceCentreInquiryAssignment.ts).
  serviceCentrePincodes      Json    @default("[]")
  /// "Serialized Inventory" toggle on /partner/<id>/settings. When false
  /// (the default — every existing partner reads as off), Service Centre
  /// workorders can use free-text parts, BOM catalog parts, and pricing
  /// freely with NO stock validation blocking Mark Completed/Close — parts
  /// are recorded for pricing only, nothing is checked or deducted against
  /// Inventory. When true, deductInventoryForWorkorderAction (see
  /// src/app/partner/[partnerId]/service-centre/[recordId]/actions.ts)
  /// fail-closed checks and deducts stock for every BOM-catalog-matched
  /// part line before allowing the job to complete.
  serializedInventoryEnabled Boolean @default(false)
  /// Free-text terms printed on the partner's own quotes/invoices — the
  /// GENERAL default. Each of the per-document-type overrides below falls
  /// back to this when blank, and a document whose specific override AND
  /// this general field are both blank prints no terms block at all (rather
  /// than empty boilerplate). Same fallback rule as AN-CRM's
  /// Business.termsAndConditions (src/models/Business.ts).
  serviceTerms               String? @db.Text
  /// --- Per-document-type Terms & Conditions overrides ---
  /// One per printable Service Centre document, each falling back to
  /// serviceTerms above. Kept as separate nullable columns rather than a
  /// JSON blob so the fallback is a plain `?? serviceTerms` at the point of
  /// render and nothing has to parse/defend against a malformed shape.
  workorderTerms             String? @db.Text
  estimateTerms              String? @db.Text
  invoiceTerms               String? @db.Text
  serviceRecordTerms         String? @db.Text
  /// Default labour charge, in WHOLE RUPEES (this app stores money in
  /// rupees, not paise — see Plan.price and ServiceLine.laborCharge, both
  /// plain rupee amounts). Used to pre-fill the labour figure on a new
  /// workorder service line. Null/0 means "no default" — the field is left
  /// blank rather than pre-filled with a zero that reads as a real quote.
  defaultLaborCharge         Int?
  /// The partner's own UPI VPA, e.g. "yourshop@okhdfcbank". Printed on the
  /// Sales Invoice as a scannable UPI payment QR (src/lib/upiQr.ts). There
  /// is no gateway, webhook or reconciliation behind it: the customer scans
  /// and pays the partner directly, and matching the payment against the
  /// invoice stays manual.
  upiId                      String?
  /// e.g. "Mon-Sat, 9:30am - 7:00pm"
  serviceHours               String?
  /// A public support number, distinct from businessContact (the number we
  /// reach the partner on).
  supportHotline             String?

  /// --- Bank details (for payouts/settlement; display + record only) ---
  /// Deliberately stored as plain nullable columns matching AN-CRM's four
  /// fields. Nothing debits these — there is no payout engine wired up.
  bankAccountName   String?
  bankName          String?
  bankAccountNumber String?
  bankIfsc          String?

  /// Subscription lifecycle: "Trial" | "Active" | "PastDue" | "Cancelled".
  /// Set to "Trial" automatically on signup with a 7-day trialEndAt; a
  /// Super Admin can freely override status/dates/plan/cycle from
  /// /admin/subscribers. There is no payment gateway wired up yet (same
  /// documented gap as central-api) — moving PastDue -> Active once a
  /// partner actually pays is a manual Super Admin action for now.
  subscriptionStatus String    @default("Trial")
  trialStartAt       DateTime?
  trialEndAt         DateTime?
  /// "Yearly" | "TwoYearly" — chosen when the partner converts off trial;
  /// null while still on trial. Only these two cycles are offered (see
  /// BILLING_CYCLES in src/lib/subscriptionData.ts).
  billingCycle       String?
  planId             String?
  offerId            String?

  /// Referral tracking: the Partner id (e.g. "SC0001") of whoever referred
  /// this partner, captured from the optional referral code entered at
  /// /signup. Null for organic signups. There is no self-referral (the code
  /// can only name an already-existing partner) and no rewards/credit
  /// ledger attached — this column records WHO referred WHOM only; issuing
  /// an actual reward is real money movement and deliberately left as a
  /// separate follow-up. Referral codes themselves aren't stored: they are
  /// derived deterministically from the partner id (see
  /// src/lib/referrals.ts), so there is nothing to generate or keep unique.
  referredByPartnerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referredByPartnerId])
  @@map("partners")
}

/// A discount or bundle a Super Admin can apply at subscribe time — a
/// straight percent/flat discount off a Plan's computed cycle price, or a
/// combo bundling several Plans together. Applied via Partner.offerId;
/// pricing math lives in src/lib/subscriptionData.ts.
model Offer {
  id            String    @id @default(cuid())
  name          String
  description   String?   @db.Text
  discountType  String    @default("percent")
  discountValue Int       @default(0)
  planIds       Json      @default("[]")
  billingCycles Json      @default("[]")
  isCombo       Boolean   @default(false)
  isActive      Boolean   @default(true)
  validFrom     DateTime?
  validTo       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("offers")
}

/// A subscription Plan (Basic/Pro/Ultimate) — Super-Admin configurable via
/// /admin/plans, and the single source of truth for the public /pricing
/// page. includedModuleSlugs is a JSON string array.
model Plan {
  id                  String   @id
  name                String
  price               Int
  /// Bare-minimum introductory monthly rate, active until subscriptionData.ts's LAUNCH_PRICING_CUTOVER (matches AN-CRM's src/core/pricing/plans.ts launchPriceINR/LAUNCH_PRICING_CUTOVER exactly) -- after which `price` applies automatically, no admin action needed. Null on a plan means no launch discount (use `price` from day one).
  launchPrice         Int?
  billingCycle        String
  includedModuleSlugs Json     @default("[]")
  maxUsers            Int
  maxLocations        Int
  isPublic            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("plans")
}

/// A signup submitted against a Partner Type with requiresApproval=true —
/// holds everything a Partner row would, but no VND#### id is assigned
/// until Super Admin approves it (see partnerSignupRequestsData.ts).
/// Generic, partner-scoped business record store — backs every module's
/// actual data (POS sales, Service Centre workorders, Billing invoices,
/// etc.) instead of a bespoke Prisma model per module. `data` mirrors the
/// module's existing Column/FormFieldDef key vocabulary exactly (see
/// src/lib/sample-data/<slug>.ts), so no per-module schema is needed —
/// the shape is already defined by each module's field definitions.
/// recordKey is the user-facing id shown in the UI (data.id); the surrogate
/// `id` here exists only because Prisma needs a stable primary key.
model BusinessRecord {
  id         String   @id @default(cuid())
  partnerId  String
  moduleSlug String
  recordKey  String
  data       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([partnerId, moduleSlug, recordKey])
  @@index([partnerId, moduleSlug])
  @@map("business_records")
}

/// A captured Razorpay payment for a partner's subscription. Previously
/// nothing persisted this — the webhook/verify routes only flipped
/// Partner.subscriptionStatus and discarded the amount/payment id/date from
/// the Razorpay payload. Recorded here now so there's an actual payment
/// history, and so the central-api sync (see notifyCentralApi in
/// src/lib/centralApi.ts) has a stable id to dedupe retries against.
model SubscriptionPayment {
  id                String   @id @default(cuid())
  partnerId         String
  razorpayPaymentId String   @unique
  amount            Int
  currency          String   @default("INR")
  capturedAt        DateTime
  createdAt         DateTime @default(now())

  @@index([partnerId])
  @@map("subscription_payments")
}

model PartnerSignupRequest {
  id              String   @id @default(cuid())
  partnerTypeId   String
  businessName    String
  addressLine     String?
  city            String
  state           String
  pincode         String
  gstin           String?
  businessEmail   String
  businessContact String
  loginContact    String
  passwordHash    String
  /// Carried through from the signup form so an approval-gated signup
  /// doesn't silently lose the domains the applicant picked — copied onto
  /// the Partner row by createPartnerFromRequest(). Same shape as
  /// Partner.productDomains.
  productDomains  Json     @default("[]")
  status          String   @default("Pending")
  createdAt       DateTime @default(now())

  @@map("partner_signup_requests")
}

/// The per-module "main key" for a partner — a module being in
/// PartnerType.defaultModules only controls whether it's toggled on for the
/// plan; this is the actual per-partner secret/gate a module's data-access
/// functions check before returning anything (see assertModuleAccess in
/// src/lib/tenant.ts). Issued/revoked by Super Admin from /admin/access-keys.
model ModuleAccessKey {
  id         String    @id @default(cuid())
  partnerId  String
  moduleSlug String
  key        String    @unique
  status     String    @default("active") // active | revoked
  issuedAt   DateTime  @default(now())
  revokedAt  DateTime?
  note       String?

  @@unique([partnerId, moduleSlug])
  @@map("module_access_keys")
}

/// A staff account belonging to exactly one Partner — gives a Service
/// Centre business owner a way to onboard a technician/front-desk/manager
/// with their own login instead of everyone sharing the single Partner
/// account. Deliberately a real Prisma model (not a BusinessRecord) for the
/// same reason Field Force's Provider is: this needs real credential
/// storage and a unique-login constraint, not a JSON blob. Scope is
/// intentionally simple for this first pass — `role` is a plain string, not
/// AN-CRM's full custom-role/permission-matrix system (Role/Permission/
/// RolePermission) — see the authorization note on requireServiceCentreStaff
/// in src/lib/staffAuth.ts. partnerId is a loose, string-only reference (no
/// @relation) — same convention Partner's own scoped models (BusinessRecord,
/// ModuleAccessKey, etc.) already use, not a hard FK.
model PartnerStaff {
  id        String @id @default(cuid())
  partnerId String

  name               String
  /// Optional now (was required) — Telecaller agents log in with loginId
  /// below instead of email, and don't necessarily have a work email to give.
  /// Still required for every role that predates this (Owner/Manager/
  /// Technician/FrontDesk created before this column existed keep theirs).
  email              String?
  phone              String?
  passwordHash       String
  /// "Owner" | "Manager" | "Technician" | "FrontDesk" | "Telecaller" — a
  /// plain string, not an AN-CRM-style per-action permission matrix
  /// (documented fast-follow).
  role               String   @default("Technician")
  status             String   @default("Active") // Active | Suspended
  /// True until the staff member completes their first forced password
  /// change — same convention as Partner.mustChangePassword; set when the
  /// Partner owner creates the account with a generated password.
  mustChangePassword Boolean  @default(true)
  /// Short generated login id (e.g. "AGT001"), unique per partner — the
  /// Telecalling module's own login credential instead of email, since an
  /// agent shouldn't need a real email address just to sign in and it's
  /// easier to read back over the phone than one. Nullable/unused for every
  /// other role today. See src/lib/telecalling/agentAuth.ts.
  loginId            String?
  /// Telecalling-only territory gate: the states/cities (Lead.state/
  /// Lead.city, both plain free-text as typed on a lead's CSV import — no
  /// canonical state/city master list exists yet) this Telecaller may see
  /// and be auto-assigned. Empty array on both means "no restriction" — an
  /// agent created before this feature, or explicitly given open access,
  /// sees every lead exactly as before. Unused for every other role. See
  /// src/lib/telecalling/leadsData.ts's territory filtering and
  /// autoAssignByTerritory().
  assignedStates     Json     @default("[]")
  assignedCities     Json     @default("[]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  assignedLeads Lead[]
  calls         Call[]

  @@unique([partnerId, email])
  @@unique([partnerId, loginId])
  @@index([partnerId])
  @@map("partner_staff")
}

// --- Field Force module: a two-sided home-services marketplace. Customers ---
// --- request bookings; Providers (skilled/unskilled workers, onboarded  ---
// --- individually or as a team) get matched and dispatched by service + ---
// --- pincode. Both sides can self-signup or be onboarded by ops.        ---

/// The catalog of services a Provider can offer — ops-editable from
/// field-force/admin (add/edit/deactivate), so new categories/services
/// don't need a schema change. Also the customer-facing booking catalog:
/// basePrice/durationMinutes/priceType drive what a Booking charges.
model Service {
  id              String   @id @default(cuid())
  name            String   @unique
  category        String
  description     String?  @db.Text
  /// "fixed" | "hourly" — how basePrice is interpreted.
  priceType       String   @default("fixed")
  /// Paise. Fixed = flat job price; hourly = rate per hour (Booking still
  /// stores a single computed priceAmount at booking time).
  basePrice       Int      @default(0)
  durationMinutes Int      @default(60)
  /// "unskilled" | "skilled" — informational only (doesn't gate matching):
  /// which class of worker this service is typically staffed by, shown in
  /// the catalog and on a Booking so ops can plan pay rate/dispatch.
  minSkillLevel   String   @default("skilled")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  providerServices ProviderService[]
  bookings         Booking[]

  @@map("services")
}

/// A Provider — a worker (skilled or unskilled) who fulfills bookings.
/// Partner-scoped (each partner runs their own Provider pool/storefront) —
/// self-signup only makes sense against one partner's own brand, so this is
/// no longer a platform-wide pool. A Provider can onboard their own team
/// under them (teamLeadId self-relation); each team member has their own
/// login and independently selects their own services/skill level.
/// passwordHash is null until self-signup (or a later "set password" step)
/// happens — ops can onboard a Provider with no login ability yet.
model Provider {
  id                String     @id @default(cuid())
  partnerId         String
  name              String
  phone             String
  email             String?
  source            String?
  /// Mandatory primary coverage pincode — every Provider must have one.
  pincode           String
  /// "unskilled" | "skilled" — set at onboarding, editable from admin. Both
  /// classes of worker are onboarded and dispatched the same way; this is a
  /// descriptive attribute (pay/training expectations), not a matching gate
  /// — see src/lib/fieldForce/matching.ts.
  skillLevel        String     @default("skilled")
  status            String     @default("pending") // pending | active | suspended
  passwordHash      String?
  preferredLanguage String     @default("en")
  teamLeadId        String?
  teamLead          Provider?  @relation("ProviderTeam", fields: [teamLeadId], references: [id])
  teamMembers       Provider[] @relation("ProviderTeam")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  services     ProviderService[]
  serviceAreas ProviderServiceArea[]
  allocations  JobAllocation[]
  bookings     Booking[]
  jobOffers    JobOffer[]

  @@unique([partnerId, phone])
  @@index([partnerId])
  @@index([pincode])
  @@map("providers")
}

/// One row per service a Provider has selected during onboarding —
/// providers can select as many as apply, no cap.
model ProviderService {
  id         String   @id @default(cuid())
  providerId String
  serviceId  String
  provider   Provider @relation(fields: [providerId], references: [id])
  service    Service  @relation(fields: [serviceId], references: [id])

  @@unique([providerId, serviceId])
  @@map("provider_services")
}

/// One row per serviceable area a Provider has added, beyond their
/// mandatory primary pincode — each row is independently EITHER a
/// state/district/locality combination OR a single pincode (pincode set,
/// district/locality left null), matching the onboarding form's
/// "select either of them" per-row toggle.
model ProviderServiceArea {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id])
  state      String
  district   String?
  locality   String?
  pincode    String?

  @@index([providerId])
  @@map("provider_service_areas")
}

/// A Provider allocated to a Booking. Kept as the assignment/audit record
/// (a Provider can be reassigned; each row is one assignment), with status
/// mirrored from Booking.status on every transition so this stays
/// consistent with the booking's own lifecycle.
model JobAllocation {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id])
  partnerId  String
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id])
  status     String   @default("assigned") // assigned | in-progress | done | cancelled
  assignedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// Billing readiness for a future commission/fee model — not surfaced in
  /// any UI yet (we charge nothing today); carried here so it doesn't need
  /// a migration later.
  feeAmount Int? // paise; null = not charged (today's default)
  feeStatus String? // pending | invoiced | paid — null today

  @@index([partnerId])
  @@index([providerId])
  @@index([bookingId])
  @@map("job_allocations")
}

/// One row per (Booking, candidate Provider) matched by pincode+service when
/// a Customer requests a booking — the automated dispatch fan-out. Created
/// by dispatchBookingRequest(), resolved by respondToOffer(): the first
/// Provider to accept confirms the Booking and every sibling offer expires.
model JobOffer {
  id          String    @id @default(cuid())
  bookingId   String
  booking     Booking   @relation(fields: [bookingId], references: [id])
  providerId  String
  provider    Provider  @relation(fields: [providerId], references: [id])
  partnerId   String
  status      String    @default("pending") // pending | accepted | declined | expired
  sentAt      DateTime  @default(now())
  respondedAt DateTime?

  @@index([bookingId])
  @@index([providerId])
  @@index([partnerId])
  @@map("job_offers")
}

/// A simple in-app notification feed, polled on page load (no
/// websockets/push yet — see field-force marketplace plan). audience "ops"
/// with recipientId null means "any partner staff viewing Field Force";
/// "customer"/"provider" always carry a recipientId.
model Notification {
  id               String   @id @default(cuid())
  partnerId        String
  audience         String // ops | customer | provider
  recipientId      String?
  type             String
  title            String
  body             String   @db.Text
  relatedBookingId String?
  isRead           Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([partnerId, audience, recipientId])
  @@map("field_force_notifications")
}

/// Per-partner toggles for the public Field Force signup pages — off by
/// default; a Super Admin turns them on from field-force/admin once a
/// partner is ready to run public signup.
model FieldForceSettings {
  partnerId             String  @id
  customerSignupEnabled Boolean @default(false)
  providerSignupEnabled Boolean @default(false)

  @@map("field_force_settings")
}

/// Per-partner Telegram alert setup — the same shape as FieldForceSettings
/// above (one row per partner, partnerId as the primary key, all-optional
/// toggles), which is this app's established per-partner-settings pattern.
///
/// chatId is the partner's OWN Telegram chat/group id (they get it from
/// @userinfobot or by adding a bot to their group). enabledTypes is the
/// list of alert-occasion keys (see TELEGRAM_ALERT_TYPES in
/// src/lib/telegram.ts, which map 1:1 onto the message-copy functions in
/// src/lib/telegramTemplates.ts) the partner wants delivered there.
///
/// NOTE: settings here are real and honoured by sendPartnerTelegramAlert(),
/// but actual delivery needs a real bot: with no TELEGRAM_BOT_TOKEN set the
/// send no-ops with a console log, exactly like src/lib/sms.ts does without
/// SMS_API_KEY. Nothing here fabricates a bot connection.
model TelegramSettings {
  partnerId        String   @id
  chatId           String?
  /// The partner's group chat id — connected independently of `chatId`
  /// (the personal/DM chat) via its own deep-link slot (see
  /// buildTelegramConnectLink(partnerId, "group") in src/lib/telegram.ts).
  /// Either, both, or neither may be set at a time.
  groupChatId      String?
  /// Friendly display name captured from Telegram's own chat data at
  /// connect time (chat.title for a group, else first/last name or
  /// @username for a personal DM — see the webhook route's `/start`
  /// handler) — lets the settings page show "Connected — Nagaraju" instead
  /// of a raw numeric chat id. Cleared automatically whenever chatId
  /// changes to a different value (see saveTelegramSettings), since an old
  /// title would otherwise stick to a new, unrelated chat.
  chatTitle        String?
  /// Same as `chatTitle`, for `groupChatId`.
  groupChatTitle   String?
  /// Per-alert-type routing: which of the two connected chats
  /// (personal/group/both/none) each TELEGRAM_ALERT_TYPES key — plus the
  /// pseudo-key "report" for the business-summary digest — is delivered to.
  /// Keyed by TelegramAlertType | "report", valued
  /// "personal" | "group" | "both" | "none" — see TelegramRoutingMap in
  /// src/lib/telegram.ts. A type with no entry here defaults to "both" (send
  /// to whichever of chatId/groupChatId is set); "none" is the replacement
  /// for the old per-type enable/disable checkbox (removed — every type is
  /// always "on", routing is the only on/off/where control now).
  routing          Json     @default("{}")
  /// Every partner with a connected chat gets ALL THREE report cadences
  /// (daily, weekly, and monthly digests — see
  /// src/lib/telegramTemplates.ts's businessReportMessage()), not a single
  /// pick-one frequency — the old `reportFrequency` NONE/DAILY/WEEKLY/MONTHLY
  /// column is gone; report delivery is now gated purely by `routing["report"]`
  /// like any other alert type. Keyed by cadence (DAILY/WEEKLY/MONTHLY), each
  /// value the last time that specific cadence was sent (or attempted) —
  /// the cron's idempotency guard, since Vercel Cron does not guarantee
  /// exactly-once delivery and this route may run more than
  /// once on the same calendar day/week/month.
  lastReportSentAt Json     @default("{}")
  updatedAt        DateTime @updatedAt

  @@map("telegram_settings")
}

/// Audit trail of every attempted Telegram alert send — real even though no
/// bot token exists yet, so the settings page can show recent activity.
/// Mirrors AN-CRM's TelegramLog model (src/models/TelegramLog.ts).
model TelegramLogEntry {
  id          String   @id
  partnerId   String
  type        String
  message     String   @db.Text
  chatId      String?
  sent        Boolean  @default(false)
  reason      String?
  createdAt   DateTime @default(now())
  /// The Bot API's own id for the message actually sent (Telegram's
  /// sendMessage response), captured only when `sent` is true. Together with
  /// chatId this is the reply-threading key: an incoming Telegram message
  /// whose `reply_to_message.message_id` matches this row is a reply to
  /// THIS alert — see findWorkorderByReplyMessageId() in src/lib/telegram.ts
  /// and the webhook route that calls it.
  messageId   Int?
  /// Which Service Centre workorder this alert was about, when sent via
  /// sendWorkorderTelegramAlert() rather than the generic
  /// sendPartnerTelegramAlert() — null for occasions that aren't yet
  /// workorder-aware (see src/lib/telegram.ts).
  workorderId String?

  @@index([partnerId, createdAt])
  /// Reply-threading lookup: given the chatId + message_id a reply came in
  /// on, find the one log row (and therefore workorder) that message_id was
  /// originally sent for.
  @@index([chatId, messageId])
  @@map("telegram_log_entries")
}

/// One row per scheduled/manual report *run* (cron invocation or a Super
/// Admin "push now"), not per partner-send — see ReportRunPartnerResult for
/// the per-partner breakdown nested inside `details`. Lets the My Biz Flow
/// Admin app show "was today's DAILY run triggered, and did it fully
/// succeed" without re-deriving that from TelegramLogEntry (which is
/// per-alert-send, not scoped to the report digest specifically, and has no
/// concept of a "run" grouping several partners together).
model ReportRunLogEntry {
  id        String   @id
  cadence   String
  trigger   String
  /// Total partners considered for this run (due + already-sent-today +
  /// opted-out all count here, per `skipped`/`sent`/`failed` below), so a 0
  /// here immediately shows "nobody was even considered", not just "nobody
  /// succeeded".
  attempted Int
  sent      Int
  failed    Int
  skipped   Int      @default(0)
  /// [{partnerId, businessName, ok, error?}] for every partner actually
  /// attempted this run (excludes skipped-as-not-due) — the "who, and why
  /// not" the ops summary needs. See ReportPushDetail in
  /// src/lib/telegramReportData.ts, same shape.
  details   Json
  createdAt DateTime @default(now())

  @@index([cadence, createdAt])
  @@map("report_run_log_entries")
}

/// Admin-editable override for a Telegram message template's body text —
/// keyed by the template's canonical key (see src/lib/telegramTemplateDefs.ts,
/// duplicated in My Biz Flow Admin where the edit UI lives). No row for a
/// key means the hardcoded defaultBody in that file is used — same
/// "DB overrides a code default" convention as ModuleAppearance/
/// PageCustomization. Global/platform-wide, not partner-scoped: these are
/// the platform's own wording, not something a partner customizes.
model TelegramMessageTemplate {
  key       String   @id
  body      String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("telegram_message_templates")
}

/// Admin-editable override for a transactional email's copy — same pattern
/// as TelegramMessageTemplate above (key + override fields + updatedAt, code
/// default in src/lib/emailTemplateDefs.ts used when no row exists here).
/// Structural pieces (info-box rows, button URLs) stay code-driven since
/// they carry real data (amounts, order numbers) rather than wording; only
/// subject/heading/body/footNote — the parts an admin would actually want
/// to reword — are stored here.
model EmailTemplate {
  key        String   @id
  subject    String
  heading    String
  body       String   @db.Text
  footNote   String?  @db.Text
  /// "text" (default): body is plain text, \n\n-separated paragraphs,
  /// auto-wrapped into <p> blocks. "html": body is used verbatim as raw
  /// HTML (still {{token}}-filled) — lets an admin hand-craft layout/markup
  /// beyond the plain-paragraph default when they need to.
  bodyFormat String   @default("text")
  updatedAt  DateTime @updatedAt

  @@map("email_templates")
}

/// The platform's own commission on a Booking — a single global row
/// (Super-Admin-only, same "platform-level, not partner-scoped" posture as
/// Plan/Offer), not yet automatically collected/paid out (see
/// src/lib/fieldForce/commission.ts — computes a ledger number only).
model PlatformFeeConfig {
  id                   String   @id @default("default")
  feeType              String   @default("percent") // percent | flat
  feeValue             Int      @default(0) // percent: 0-100; flat: paise
  chargeParty          String   @default("customer") // customer | provider | both
  /// Only used when chargeParty = "both" — the Provider's share of the fee
  /// (the rest comes from the Customer side).
  providerSharePercent Int      @default(50)
  isActive             Boolean  @default(false)
  updatedAt            DateTime @updatedAt

  @@map("platform_fee_config")
}

// --- Customer-facing booking layer: a partner's own customers/addresses, ---
// --- and the priced Booking (job) that gets dispatched to a Provider,   ---
// --- paid, and rated.                                                   ---

/// A partner's own end customer. One row per unique (partnerId, phone).
/// passwordHash is null until self-signup (or a later "set password" step).
model Customer {
  id                String   @id @default(cuid())
  partnerId         String
  name              String
  phone             String
  email             String?
  passwordHash      String?
  preferredLanguage String   @default("en")
  createdAt         DateTime @default(now())

  addresses Address[]
  bookings  Booking[]

  @@unique([partnerId, phone])
  @@index([partnerId])
  @@map("customers")
}

/// A saved address for a Customer — a booking always points at one of these.
model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  label      String   @default("Home")
  line1      String
  line2      String?
  landmark   String?
  city       String
  state      String
  pincode    String
  isDefault  Boolean  @default(false)

  bookings Booking[]

  @@index([customerId])
  @@map("addresses")
}

/// The core job/order: a customer's request for one Service, scheduled,
/// priced, dispatched to a Provider, paid, and rated — the Urban
/// Company-style booking lifecycle this module runs on.
model Booking {
  id            String @id @default(cuid())
  partnerId     String
  bookingNumber String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  addressId  String
  address    Address  @relation(fields: [addressId], references: [id])
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id])

  providerId String?
  provider   Provider? @relation(fields: [providerId], references: [id])

  /// requested | confirmed | assigned | en-route | in-progress | completed | cancelled
  status        String   @default("requested")
  scheduledAt   DateTime
  slotLabel     String
  priceAmount   Int // paise, quoted standard rate from Service at booking time
  /// The actually-agreed price once Customer/Provider finalize it by
  /// conversation — falls back to priceAmount if never set.
  finalPrice    Int?
  /// unpaid | paid | refunded
  paymentStatus String   @default("unpaid")
  notes         String?  @db.Text

  /// Computed from finalPrice/priceAmount + the active PlatformFeeConfig at
  /// payment-collection time — see src/lib/fieldForce/commission.ts.
  platformFeeAmount Int?
  customerPayable   Int?
  providerPayout    Int?

  ratingValue   Int?
  ratingComment String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations JobAllocation[]
  payments    BookingPayment[]
  jobOffers   JobOffer[]

  @@index([partnerId])
  @@index([providerId])
  @@index([status])
  @@map("bookings")
}

/// A captured Razorpay payment for one Booking — mirrors SubscriptionPayment's
/// shape/idempotency convention, kept separate since it settles a booking,
/// not a partner subscription.
model BookingPayment {
  id                String   @id @default(cuid())
  bookingId         String
  booking           Booking  @relation(fields: [bookingId], references: [id])
  razorpayOrderId   String
  razorpayPaymentId String?  @unique
  amount            Int
  currency          String   @default("INR")
  status            String   @default("created") // created | paid | failed
  createdAt         DateTime @default(now())

  @@index([bookingId])
  @@map("booking_payments")
}

// --- Telecalling module: bulk-uploaded contact lists worked by ---
// --- PartnerStaff agents (role "Telecaller") who place calls via the  ---
// --- device dialer (tel: link, no telephony vendor) and trigger      ---
// --- SMS/WhatsApp template messages — see src/lib/telecalling/.      ---

/// One uploaded/entered contact to be called. importBatch groups rows from
/// the same CSV upload (or "Manual" for one-off adds) for filtering/reporting.
model Lead {
  id           String        @id @default(cuid())
  partnerId    String
  name         String
  phone        String
  email        String?
  source       String?
  state        String?
  city         String?
  importBatch  String        @default("Manual")
  /// New | Contacted | Interested | Converted | Lost | DoNotCall
  status       String        @default("New")
  assignedToId String?
  assignedTo   PartnerStaff? @relation(fields: [assignedToId], references: [id])
  notes        String?       @db.Text
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  calls    Call[]
  messages MessageLog[]

  @@index([partnerId])
  @@index([assignedToId])
  @@index([partnerId, status])
  @@map("leads")
}

/// One logged call attempt against a Lead. The call itself happens on the
/// agent's own phone (tel: click-to-call, no CDR/recording available) — this
/// row is the agent's own disposition record of what happened.
model Call {
  id         String       @id @default(cuid())
  leadId     String
  lead       Lead         @relation(fields: [leadId], references: [id])
  partnerId  String
  agentId    String
  agent      PartnerStaff @relation(fields: [agentId], references: [id])
  /// Interested | NotReachable | Callback | Converted | DoNotCall | WrongNumber
  outcome    String
  notes      String?      @db.Text
  callbackAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([leadId])
  @@index([partnerId])
  @@map("calls")
}

/// A reusable SMS/WhatsApp message body an agent can trigger for a Lead —
/// {{name}}/{{link}} placeholders filled in at send time (src/lib/telecalling/messaging.ts).
model MessageTemplate {
  id        String   @id @default(cuid())
  partnerId String
  name      String
  /// "sms" | "whatsapp"
  channel   String
  /// Welcome | ProductInfo | FollowUp | General
  category  String   @default("General")
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs MessageLog[]

  @@unique([partnerId, name])
  @@index([partnerId])
  @@map("message_templates")
}

/// Audit trail of every triggered message — one row per send attempt.
model MessageLog {
  id         String           @id @default(cuid())
  leadId     String
  lead       Lead             @relation(fields: [leadId], references: [id])
  templateId String?
  template   MessageTemplate? @relation(fields: [templateId], references: [id])
  partnerId  String
  channel    String
  body       String           @db.Text
  /// sent | failed | not-configured
  status     String           @default("sent")
  sentById   String?
  createdAt  DateTime         @default(now())

  @@index([leadId])
  @@index([partnerId])
  @@map("message_logs")
}

/// One-time Telegram-delivered verification code gating a partner's own
/// Customer database (viewing the list/detail, or exporting it) — customer
/// contact data is private, so unlocking it takes more than just being
/// logged in as the partner. One row per partner (upserted on each new
/// request); `verifiedUntil` is the actual unlock — see
/// src/lib/customerDataAccess.ts.
model CustomerDataAccessOtp {
  partnerId     String    @id
  codeHash      String
  expiresAt     DateTime
  attempts      Int       @default(0)
  verifiedUntil DateTime?
  updatedAt     DateTime  @updatedAt

  @@map("customer_data_access_otps")
}

/// Same Telegram-verified one-time-code gate as CustomerDataAccessOtp, but
/// guarding a different sensitive action: reopening a workorder that's
/// already reached Completed back to In Progress. Keyed by workorderId
/// (not partnerId) since several workorders for the same partner could have
/// a reopen request outstanding at once; the code still goes to the
/// partner's own connected personal Telegram chat (the "Owner"), same as
/// customer-data access.
model WorkorderReopenOtp {
  workorderId   String    @id
  partnerId     String
  codeHash      String
  expiresAt     DateTime
  attempts      Int       @default(0)
  verifiedUntil DateTime?
  updatedAt     DateTime  @updatedAt

  @@map("workorder_reopen_otps")
}

/// Generic, purpose-keyed OTP table shared with My-Biz-Flow-Admin (same
/// physical DB, same table — see that app's src/lib/inventoryOtp.ts for
/// the reference implementation this schema block is copied verbatim
/// from). `purpose` distinguishes what the code is gating (e.g.
/// "stock-take-close", "stock-transfer-close"); `targetRecordId` is the
/// gated document's id. One row per (partnerId, targetRecordId, purpose)
/// in practice — enforced at the application layer (delete-then-create on
/// each new request), not by a DB unique constraint, since the table is
/// shared across two independently-deployed codebases and neither owns a
/// migration that could add one retroactively without coordinating the
/// other.
model OtpCode {
  id             String    @id @default(cuid())
  partnerId      String
  purpose        String
  targetRecordId String
  code           String
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([partnerId, targetRecordId, purpose])
  @@map("otp_codes")
}

/// Pro+ money ledger (credit/debit) for Inventory documents that carry a
/// cost impact — Stock Take, Stock Adjustments, Stock Transfers, Return
/// Orders, Part Orders. One row per (partner, source document, source
/// type), upserted idempotently so re-processing the same document never
/// double-books it. `amount` is Int paise, matching every other money
/// field in this schema (see e.g. WorkorderBooking.priceAmount). Shared
/// physical table with My-Biz-Flow-Admin (same DB) — shape copied
/// verbatim from that app's prisma/schema.prisma.
model InventoryTransaction {
  id             String   @id @default(cuid())
  partnerId      String
  sourceType     String
  sourceRecordId String
  direction      String
  amount         Int
  description    String
  occurredAt     DateTime
  createdAt      DateTime @default(now())

  @@unique([partnerId, sourceRecordId, sourceType])
  @@index([partnerId, occurredAt])
  @@index([partnerId, sourceRecordId])
  @@map("inventory_transactions")
}

/// Per-unit/per-batch stock lot — the substrate for FIFO draw order,
/// serialized exact-ageing, and barcode/lot tracking. A serialized
/// material gets one row per unit (serialNumber set, quantityReceived/
/// quantityRemaining always 1/1 or 1/0); a non-serialized material gets
/// one row per receipt batch, drawn down FIFO by receivedAt. `unitCost`
/// is Int paise, same convention as InventoryTransaction.amount. Shared
/// physical table with My-Biz-Flow-Admin (same DB) — every field except
/// `condition` is copied verbatim from that app's shape.
/// `condition` ("Good" | "Defective") is a My-Biz-Flow-only, additive,
/// nullable column: this app tracks stock condition as a first-class
/// dimension (return-orders, part-orders, inventoryStock.ts) but
/// My-Biz-Flow-Admin does not, so it's added nullable specifically so
/// Admin's existing rows/code are entirely unaffected — Admin simply
/// never sets it.
model StockLot {
  id                String    @id @default(cuid())
  partnerId         String
  warehouseId       String?
  warehouseName     String?
  materialId        String
  materialLabel     String
  serialized        Boolean   @default(false)
  serialNumber      String?
  quantityReceived  Int
  quantityRemaining Int
  unitCost          Int
  receivedAt        DateTime
  sourceType        String?
  sourceRecordId    String?
  consumedAt        DateTime?
  createdAt         DateTime  @default(now())
  /// My-Biz-Flow-only additive column — see model doc comment above.
  condition         String?

  @@index([partnerId, materialId, warehouseId, receivedAt])
  @@index([partnerId, materialId, serialNumber])
  @@map("stock_lots")
}

/// Material consumption ledger (workorder deduction, POS sale,
/// manufacturing production) — shared physical table with
/// My-Biz-Flow-Admin (same DB), shape copied verbatim from that app's
/// prisma/schema.prisma. Money fields here are Float RUPEES (not Int
/// paise) — an intentional exception to this schema's usual paise
/// convention, matching the table's actual live shape exactly.
model MaterialConsumption {
  id             String   @id @default(cuid())
  partnerId      String
  sourceType     String
  sourceRecordId String
  materialId     String
  materialLabel  String
  warehouseId    String?
  warehouseName  String?
  quantity       Float
  unitCost       Float
  valueAmount    Float
  occurredAt     DateTime
  createdAt      DateTime @default(now())

  @@index([partnerId, occurredAt])
  @@index([partnerId, sourceType])
  @@index([partnerId, materialId])
  @@map("material_consumption")
}

/// Links a Telegram message this app sent about a support ticket back to
/// that ticket, so a reply in Telegram (which only carries the message_id
/// it's replying to, not the ticket id) can be resolved to the right
/// conversation — same threading pattern as TelegramLogEntry.workorderId,
/// generalized for support tickets (a different module, not worth
/// overloading that table's workorder-specific fields for).
model SupportTicketTelegramLink {
  id        String   @id @default(cuid())
  chatId    String
  messageId Int
  partnerId String
  ticketId  String
  createdAt DateTime @default(now())

  @@unique([chatId, messageId])
  @@index([partnerId, ticketId])
  @@map("support_ticket_telegram_links")
}

/// India Post pincode directory, our own backing table for
/// src/app/api/pincode/route.ts so lookups don't depend on the live
/// api.postalpincode.in API being up, and so partner serviceable-area
/// pickers have a real browsable state -> city -> pincode/locality list
/// (the live API only answers single-pincode lookups, not browsing).
/// Seeded/refreshed periodically from the official All India Pincode
/// Directory (data.gov.in) via scripts/syncPincodes.ts. The live API is
/// still used as a fallback when a pincode isn't found here (not yet
/// synced, or newly issued).
model PostalPincode {
  id         String   @id @default(cuid())
  pincode    String
  officeName String
  district   String
  state      String
  updatedAt  DateTime @updatedAt

  @@unique([pincode, officeName])
  @@index([pincode])
  @@index([state, district])
  @@map("postal_pincodes")
}

/// A submission from the public marketing site's Contact Us form
/// (src/app/contact/actions.ts) — ops-facing, not partner-scoped. Super
/// Admin reviews these from My-Biz-Flow-Admin (same physical DB, mirrored
/// model there).
model ContactSubmission {
  id           String    @id @default(cuid())
  name         String
  email        String
  message      String
  resolvedAt   DateTime?
  resolvedNote String?
  createdAt    DateTime  @default(now())

  @@index([resolvedAt])
  @@map("contact_submissions")
}

/// A public Book Appointment inquiry that no partner's configured Service
/// Area could match (see src/lib/serviceCentreInquiryAssignment.ts) — not
/// partner-scoped (there is no partner to scope it to), so it lives in its
/// own ops-facing table rather than BusinessRecord, which requires a
/// partnerId. Super Admin reviews/resolves these from My-Biz-Flow-Admin
/// (same physical DB, mirrored model there) — this is the queue behind the
/// "notify Super Admin so they can handle it manually" requirement.
model UnassignedInquiry {
  id            String    @id @default(cuid())
  customerName  String
  customerPhone String
  serviceType   String
  complaint     String
  pincode       String
  addressLine   String?
  brand         String?
  model         String?
  /// Set once Super Admin has manually routed/handled this one — kept
  /// rather than deleted, as a record of how many inquiries went unrouted.
  resolvedAt    DateTime?
  resolvedNote  String?
  createdAt     DateTime  @default(now())

  @@index([resolvedAt])
  @@map("unassigned_inquiries")
}

/// POS is its own standalone module with its own login identity, separate
/// from the main partner session every other module (Service Centre,
/// Billing, Inventory...) uses — no customer-facing side at all (unlike
/// Field Force's customer+provider split), just staff/cashiers running the
/// till. One PosAccount per partner that has POS enabled, identified by a
/// human-readable accountNumber ("POS0001" — see getNextNumber("pos.account",
/// partnerId, ...) in src/lib/pos/posAuth.ts), under which individual staff
/// (PosStaff) get their own login with a composite staffCode
/// ("POS0001-01") built from the account number plus a per-account
/// sequence (getNextNumber(`pos.staff.${posAccountId}`, ...)).
model PosAccount {
  id            String   @id @default(cuid())
  partnerId     String   @unique
  accountNumber String
  outletName    String?
  status        String   @default("Active") // Active | Suspended
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  staff        PosStaff[]
  tillSessions PosTillSession[]

  @@index([partnerId])
  @@map("pos_accounts")
}

/// A POS staff login — deliberately its own credential, not the main
/// partner session. `staffCode` (e.g. "POS0001-01") is what a cashier
/// types in to log in, not a phone number (unlike Field Force's Provider,
/// which is customer/technician-facing) — this is an internal employee
/// code. `role` gates till-session and void/report actions
/// (src/lib/pos/posAuth.ts's requirePosRole) without needing a full
/// permission matrix: "Cashier" runs sales, "Manager" additionally opens/
/// closes till sessions, approves returns, and views reports.
model PosStaff {
  id           String     @id @default(cuid())
  posAccountId String
  posAccount   PosAccount @relation(fields: [posAccountId], references: [id])
  staffCode    String     @unique
  name         String
  phone        String?
  role         String     @default("Cashier") // Cashier | Manager
  passwordHash String
  status       String     @default("Active") // Active | Inactive
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  openedTillSessions PosTillSession[] @relation("TillOpenedBy")
  closedTillSessions PosTillSession[] @relation("TillClosedBy")

  @@index([posAccountId])
  @@map("pos_staff")
}

/// A cash-drawer session at one outlet — opened with a counted starting
/// float, closed with a physical cash count reconciled against what the
/// system expects (openingFloat + cash sales rung up during the session).
/// `locationId` is a Brand > Location row's id (src/lib/sample-data/brand.ts)
/// — not a Prisma relation, since Brand/Location still lives in the
/// generic BusinessRecord store, not its own Prisma model. Only one Open
/// session per (posAccountId, locationId) is allowed at a time (enforced in
/// src/lib/pos/posTill.ts, not by a DB constraint, since "Open" isn't a
/// fixed value Postgres can uniquely index against a nullable partner
/// column) — checkout refuses to ring up a sale against a Closed/missing
/// session (see requireOpenTillSession).
model PosTillSession {
  id              String     @id @default(cuid())
  posAccountId    String
  posAccount      PosAccount @relation(fields: [posAccountId], references: [id])
  locationId      String
  openedByStaffId String
  openedByStaff   PosStaff   @relation("TillOpenedBy", fields: [openedByStaffId], references: [id])
  openingFloat    Int
  openedAt        DateTime   @default(now())
  closedByStaffId String?
  closedByStaff   PosStaff?  @relation("TillClosedBy", fields: [closedByStaffId], references: [id])
  countedCash     Int?
  expectedCash    Int?
  variance        Int?
  closedAt        DateTime?
  status          String     @default("Open") // Open | Closed
  notes           String?

  @@index([posAccountId, locationId, status])
  @@map("pos_till_sessions")
}

// =====================================================================
// Schema-design-only stage (2026-09-25): dedicated tables for 8 modules
// that previously would have used the generic BusinessRecord store.
// NO Service Centre / Billing tables are touched anywhere below — see
// CLAUDE.md's explicit do-not-touch list. Every model here is NEW.
// Migration SQL for this block lives at
// prisma/migrations/20260925160000_add_eight_module_tables/migration.sql
// and has NOT been applied — a human must review and run it.
// =====================================================================

// ---------------------------------------------------------------------
// ==== Manufacturing ====
// Raw-material stock deduction keeps using the existing BusinessRecord-
// backed src/lib/inventoryStock.ts ("inventory-stock" moduleSlug) — out
// of scope here, materialId below is a loose string reference into that
// same store, not a Prisma relation.
// ---------------------------------------------------------------------

/// A manufacturable product's bill of materials — replaces the old
/// free-text "BOM Reference" + ad hoc JSON bomLines that used to live on a
/// BusinessRecord. `version`/`isActive` let a product have a history of
/// BOM revisions with only one active at a time (enforced in app logic).
model BillOfMaterial {
  id          String   @id @default(cuid())
  partnerId   String
  productName String
  productCode String?
  version     Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  lines            BomLine[]
  productionOrders ProductionOrder[]

  @@index([partnerId])
  @@map("bill_of_materials")
}

/// One material line on a BillOfMaterial. materialId/materialLabel mirror
/// the loose-reference convention StockLot/MaterialConsumption already use
/// for pointing at inventory-stock's BusinessRecord-backed catalog — no
/// Prisma relation into that store.
model BomLine {
  id            String         @id @default(cuid())
  bomId         String
  bom           BillOfMaterial @relation(fields: [bomId], references: [id])
  materialId    String
  materialLabel String
  quantity      Float
  unitCost      Int // paise

  @@index([bomId])
  @@map("bom_lines")
}

/// A physical production line/station a ProductionOrder can be scheduled
/// against — ops-editable, no capacity-booking engine yet (capacityPerDay
/// is informational only in this pass).
model WorkCenter {
  id             String  @id @default(cuid())
  partnerId      String
  name           String
  capacityPerDay Int?
  isActive       Boolean @default(true)

  productionOrders ProductionOrder[]

  @@index([partnerId])
  @@map("work_centers")
}

/// A production run against a BillOfMaterial — the core Manufacturing
/// job record.
model ProductionOrder {
  id                   String          @id @default(cuid())
  partnerId            String
  bomId                String?
  bom                  BillOfMaterial? @relation(fields: [bomId], references: [id])
  productName          String
  quantityPlanned      Int
  quantityProduced     Int             @default(0)
  workCenterId         String?
  workCenter           WorkCenter?     @relation(fields: [workCenterId], references: [id])
  /// Planned | InProduction | QC | Completed | Delayed
  status               String          @default("Planned")
  plannedStartDate     DateTime?
  plannedEndDate       DateTime?
  actualCompletionDate DateTime?
  createdAt            DateTime        @default(now())

  stageHistory ProductionStageHistory[]

  @@index([partnerId])
  @@index([bomId])
  @@index([workCenterId])
  @@map("production_orders")
}

/// Audit trail of stage transitions for a ProductionOrder — tenant-scoped
/// via its parent (no partnerId of its own: a stage-history row only ever
/// exists attached to a ProductionOrder, same convention as BomLine).
model ProductionStageHistory {
  id                String          @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id])
  stage             String
  enteredAt         DateTime        @default(now())
  note              String?         @db.Text

  @@index([productionOrderId])
  @@map("production_stage_history")
}

// ---------------------------------------------------------------------
// ==== Wholesale B2B ====
// ---------------------------------------------------------------------

model WholesaleCustomer {
  id             String   @id @default(cuid())
  partnerId      String
  name           String
  contact        String?
  gstin          String?
  creditLimit    Int      @default(0) // paise
  creditTermDays Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  orders WholesaleOrder[]

  @@index([partnerId])
  @@map("wholesale_customers")
}

model PriceTier {
  id              String @id @default(cuid())
  partnerId       String
  name            String
  discountPercent Int    @default(0)

  orders WholesaleOrder[]

  @@index([partnerId])
  @@map("price_tiers")
}

model WholesaleOrder {
  id          String            @id @default(cuid())
  partnerId   String
  customerId  String
  customer    WholesaleCustomer @relation(fields: [customerId], references: [id])
  priceTierId String?
  priceTier   PriceTier?        @relation(fields: [priceTierId], references: [id])
  orderNumber String
  /// Pending | Confirmed | Dispatched | Delivered | Cancelled
  status      String            @default("Pending")
  orderDate   DateTime          @default(now())
  totalAmount Int               @default(0) // paise
  createdAt   DateTime          @default(now())

  lines WholesaleOrderLine[]

  @@unique([partnerId, orderNumber])
  @@index([partnerId])
  @@index([customerId])
  @@map("wholesale_orders")
}

/// Tenant-scoped via its parent WholesaleOrder (no own partnerId), same
/// convention as BomLine.
model WholesaleOrderLine {
  id            String         @id @default(cuid())
  orderId       String
  order         WholesaleOrder @relation(fields: [orderId], references: [id])
  materialId    String
  materialLabel String
  quantity      Float
  unitPrice     Int // paise

  @@index([orderId])
  @@map("wholesale_order_lines")
}

// ---------------------------------------------------------------------
// ==== Event Booking ====
// ---------------------------------------------------------------------

model Venue {
  id        String  @id @default(cuid())
  partnerId String
  name      String
  address   String?
  capacity  Int?
  isActive  Boolean @default(true)

  bookings EventBooking[]

  @@index([partnerId])
  @@map("venues")
}

model EventBooking {
  id              String   @id @default(cuid())
  partnerId       String
  venueId         String?
  venue           Venue?   @relation(fields: [venueId], references: [id])
  eventName       String
  /// OneTime | Recurring
  bookingType     String   @default("OneTime")
  startAt         DateTime
  endAt           DateTime
  customerName    String
  customerContact String?
  /// Requested | Confirmed | InProgress | Completed | Cancelled
  status          String   @default("Requested")
  totalAmount     Int      @default(0) // paise
  amountPaid      Int      @default(0) // paise
  createdAt       DateTime @default(now())

  resourceAllocations EventResourceAllocation[]

  @@index([partnerId])
  @@index([venueId])
  @@map("event_bookings")
}

model EventResource {
  id        String  @id @default(cuid())
  partnerId String
  name      String
  category  String?
  isActive  Boolean @default(true)

  allocations EventResourceAllocation[]

  @@index([partnerId])
  @@map("event_resources")
}

/// Tenant-scoped via its parent EventBooking (no own partnerId).
model EventResourceAllocation {
  id             String        @id @default(cuid())
  eventBookingId String
  eventBooking   EventBooking  @relation(fields: [eventBookingId], references: [id])
  resourceId     String
  resource       EventResource @relation(fields: [resourceId], references: [id])
  quantity       Int           @default(1)

  @@index([eventBookingId])
  @@index([resourceId])
  @@map("event_resource_allocations")
}

// ---------------------------------------------------------------------
// ==== Legal ====
// ---------------------------------------------------------------------

model LegalClient {
  id        String   @id @default(cuid())
  partnerId String
  name      String
  contact   String?
  email     String?
  address   String?
  createdAt DateTime @default(now())

  matters LegalMatter[]

  @@index([partnerId])
  @@map("legal_clients")
}

model LegalMatter {
  id           String      @id @default(cuid())
  partnerId    String
  clientId     String
  client       LegalClient @relation(fields: [clientId], references: [id])
  matterNumber String
  title        String
  matterType   String?
  /// Open | InProgress | OnHold | Closed
  status       String      @default("Open")
  openedDate   DateTime    @default(now())
  closedDate   DateTime?

  courtDates LegalCourtDate[]
  documents  LegalDocument[]

  @@unique([partnerId, matterNumber])
  @@index([partnerId])
  @@index([clientId])
  @@map("legal_matters")
}

/// Named LegalCourtDate (not CourtDate) to avoid any future collision with
/// a generic "CourtDate" concept elsewhere in this shared-DB schema.
/// Tenant-scoped via its parent LegalMatter (no own partnerId).
model LegalCourtDate {
  id          String      @id @default(cuid())
  matterId    String
  matter      LegalMatter @relation(fields: [matterId], references: [id])
  hearingDate DateTime
  court       String?
  purpose     String?
  outcome     String?     @db.Text

  @@index([matterId])
  @@map("legal_court_dates")
}

/// Metadata only — no file storage pipeline exists in this app yet (same
/// documented gap as Partner.logoDataUrl's note), so there is no fileUrl
/// column here to point at anything real.
model LegalDocument {
  id           String      @id @default(cuid())
  matterId     String
  matter       LegalMatter @relation(fields: [matterId], references: [id])
  title        String
  documentType String?
  uploadedAt   DateTime    @default(now())

  @@index([matterId])
  @@map("legal_documents")
}

// ---------------------------------------------------------------------
// ==== Education ====
// ---------------------------------------------------------------------

model Course {
  id            String  @id @default(cuid())
  partnerId     String
  name          String
  durationWeeks Int?
  fee           Int     @default(0) // paise
  isActive      Boolean @default(true)

  batches Batch[]

  @@index([partnerId])
  @@map("courses")
}

model Batch {
  id        String    @id @default(cuid())
  partnerId String
  courseId  String
  course    Course    @relation(fields: [courseId], references: [id])
  batchName String
  startDate DateTime?
  endDate   DateTime?
  /// Upcoming | Ongoing | Completed | Cancelled
  status    String    @default("Upcoming")
  capacity  Int?

  enrollments Enrollment[]
  attendance  ClassAttendance[]

  @@index([partnerId])
  @@index([courseId])
  @@map("batches")
}

model Student {
  id              String   @id @default(cuid())
  partnerId       String
  name            String
  contact         String?
  email           String?
  guardianName    String?
  guardianContact String?
  createdAt       DateTime @default(now())

  enrollments Enrollment[]
  attendance  ClassAttendance[]

  @@index([partnerId])
  @@map("students")
}

/// Tenant-scoped via its parent Student/Batch (no own partnerId) — every
/// enrollment always hangs off a Student and Batch that are already
/// partner-scoped, so a lookup filtered by either FK is automatically
/// tenant-correct.
model Enrollment {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id])
  batchId    String
  batch      Batch    @relation(fields: [batchId], references: [id])
  enrolledAt DateTime @default(now())
  /// Active | Completed | Dropped
  status     String   @default("Active")

  feeInstallments FeeInstallment[]

  @@index([studentId])
  @@index([batchId])
  @@map("enrollments")
}

/// Tenant-scoped via its parent Enrollment (no own partnerId).
model FeeInstallment {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  dueDate      DateTime
  amount       Int // paise
  paidAt       DateTime?
  paidAmount   Int? // paise

  @@index([enrollmentId])
  @@map("fee_installments")
}

/// Distinct from HRMS's AttendanceCheckIn below (that one is staff
/// attendance; this is student class attendance).
model ClassAttendance {
  id        String   @id @default(cuid())
  batchId   String
  batch     Batch    @relation(fields: [batchId], references: [id])
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  date      DateTime
  /// Present | Absent | Late
  status    String

  @@index([batchId])
  @@index([studentId])
  @@map("class_attendance")
}

// ---------------------------------------------------------------------
// ==== HRMS (with live attendance) ====
// Deliberately a NEW, isolated Employee table — NOT reusing PartnerStaff,
// per the prior audit's explicit recommendation to keep HRMS changes
// isolated from Telecalling/POS-adjacent login flows.
// ---------------------------------------------------------------------

model Employee {
  id                 String     @id @default(cuid())
  partnerId          String
  name               String
  contact            String?
  email              String?
  department         String?
  designation        String?
  reportingManagerId String?
  reportingManager   Employee?  @relation("EmployeeManager", fields: [reportingManagerId], references: [id])
  reports            Employee[] @relation("EmployeeManager")
  joiningDate        DateTime?
  /// Active | OnLeave | Resigned | Terminated
  status             String     @default("Active")
  createdAt          DateTime   @default(now())

  checkIns      AttendanceCheckIn[]
  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]
  payslips      Payslip[]

  @@index([partnerId])
  @@index([reportingManagerId])
  @@map("employees")
}

/// The live attendance app's core table — one row per check-in (and its
/// paired check-out once that happens).
model AttendanceCheckIn {
  id              String    @id @default(cuid())
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id])
  checkInAt       DateTime  @default(now())
  checkOutAt      DateTime?
  checkInLat      Float?
  checkInLng      Float?
  checkOutLat     Float?
  checkOutLng     Float?
  checkInPhotoUrl String?
  /// Present | Late | HalfDay
  status          String    @default("Present")
  notes           String?   @db.Text

  @@index([employeeId])
  @@index([employeeId, checkInAt])
  @@map("attendance_check_ins")
}

/// Registered site(s) attendance check-ins are validated against.
model OfficeLocation {
  id                   String @id @default(cuid())
  partnerId            String
  name                 String
  lat                  Float
  lng                  Float
  geofenceRadiusMeters Int    @default(200)

  @@index([partnerId])
  @@map("office_locations")
}

model LeaveRequest {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  leaveType  String
  startDate  DateTime
  endDate    DateTime
  /// Pending | Approved | Rejected
  status     String    @default("Pending")
  reason     String?   @db.Text
  appliedAt  DateTime  @default(now())
  decidedAt  DateTime?
  decidedBy  String?

  @@index([employeeId])
  @@map("leave_requests")
}

model LeaveBalance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  leaveType  String
  totalDays  Int      @default(0)
  usedDays   Int      @default(0)

  @@unique([employeeId, leaveType])
  @@index([employeeId])
  @@map("leave_balances")
}

model Payslip {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  month       Int
  year        Int
  basicPay    Int // paise
  allowances  Int      @default(0) // paise
  deductions  Int      @default(0) // paise
  netPay      Int // paise
  generatedAt DateTime @default(now())
  /// Draft | Finalized | Paid
  status      String   @default("Draft")

  @@unique([employeeId, month, year])
  @@index([employeeId])
  @@map("payslips")
}

// ---------------------------------------------------------------------
// ==== Marketplace ====
// Scope decision (2026-09-25, per the prior audit's caution): this pass
// is SINGLE-PARTNER scoped — a partner's own listings/orders visible only
// to that partner's own storefront/customers, NOT a cross-partner
// marketplace. True cross-tenant discovery needs a separate, bigger
// design decision and is explicitly out of scope here.
// ---------------------------------------------------------------------

/// The vendor identity IS the Partner itself in this single-partner-scoped
/// pass — kept as its own row (rather than reusing Partner directly) so a
/// partner's marketplace-specific settings/status can evolve independently
/// of their core Partner record.
model MarketplaceVendor {
  id        String   @id @default(cuid())
  partnerId String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([partnerId])
  @@map("marketplace_vendors")
}

model MarketplaceListing {
  id            String   @id @default(cuid())
  partnerId     String
  title         String
  description   String?  @db.Text
  price         Int // paise
  stockQuantity Int      @default(0)
  isActive      Boolean  @default(true)
  category      String?
  createdAt     DateTime @default(now())

  orders MarketplaceOrder[]

  @@index([partnerId])
  @@map("marketplace_listings")
}

model MarketplaceOrder {
  id              String             @id @default(cuid())
  partnerId       String
  listingId       String
  listing         MarketplaceListing @relation(fields: [listingId], references: [id])
  customerName    String
  customerContact String?
  quantity        Int                @default(1)
  totalAmount     Int                @default(0) // paise
  /// Pending | Confirmed | Shipped | Delivered | Cancelled
  status          String             @default("Pending")
  orderedAt       DateTime           @default(now())

  @@index([partnerId])
  @@index([listingId])
  @@map("marketplace_orders")
}

// ---------------------------------------------------------------------
// ==== Accounting / General Ledger ====
// A separate, additive ledger — deliberately does NOT duplicate
// accounting-gst's existing GST return data (still a BusinessRecord
// moduleSlug). accounting-gst's records can later feed into this GL as
// source documents, not be replaced by it.
// Double-entry balancing (each JournalEntry's debits sum == credits sum)
// is enforced in app logic later, not a DB constraint in this pass.
// ---------------------------------------------------------------------

model ChartOfAccount {
  id              String           @id @default(cuid())
  partnerId       String
  accountCode     String
  accountName     String
  /// Asset | Liability | Equity | Income | Expense
  accountType     String
  parentAccountId String?
  parentAccount   ChartOfAccount?  @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  childAccounts   ChartOfAccount[] @relation("AccountHierarchy")
  isActive        Boolean          @default(true)

  journalLines JournalLine[]

  @@unique([partnerId, accountCode])
  @@index([partnerId])
  @@index([parentAccountId])
  @@map("chart_of_accounts")
}

model JournalEntry {
  id             String   @id @default(cuid())
  partnerId      String
  entryNumber    String
  entryDate      DateTime @default(now())
  narration      String?  @db.Text
  sourceType     String?
  sourceRecordId String?
  createdAt      DateTime @default(now())

  lines JournalLine[]

  @@unique([partnerId, entryNumber])
  @@index([partnerId])
  @@index([partnerId, entryDate])
  @@map("journal_entries")
}

/// Tenant-scoped via its parent JournalEntry (no own partnerId) — every
/// line always hangs off a JournalEntry that is already partner-scoped.
model JournalLine {
  id             String         @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry   @relation(fields: [journalEntryId], references: [id])
  accountId      String
  account        ChartOfAccount @relation(fields: [accountId], references: [id])
  debit          Int            @default(0) // paise
  credit         Int            @default(0) // paise

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}

model FiscalPeriod {
  id        String   @id @default(cuid())
  partnerId String
  name      String
  startDate DateTime
  endDate   DateTime
  isClosed  Boolean  @default(false)

  @@index([partnerId])
  @@map("fiscal_periods")
}

// =====================================================================
// Schema-design-only stage (2026-09-25, second pass): dedicated tables
// for every REMAINING module that would otherwise use the generic
// BusinessRecord store, except Service Centre, Inventory's own
// core-document migration, and Accounting-GST — all explicitly excluded
// per CLAUDE.md / this stage's instructions and left completely
// untouched. Every model here is NEW. POS itself needs no new tables
// (PosAccount/PosStaff/PosTillSession already exist) — see the note at
// the end of this block about POS's missing PartnerType row, which a
// later stage will seed.
//
// Migration SQL for this block lives at
// prisma/migrations/20260925180000_add_remaining_modules_tables/migration.sql
// and has NOT been applied — a human must review and run it.
// =====================================================================

// ---------------------------------------------------------------------
// ==== Billing ====
// Line items stay as Json on each document (matching how billing.ts's
// LineItem[] already works) rather than being normalized into their own
// table — same "don't over-normalize on a first pass" call the other 8
// modules made for BomLine/WholesaleOrderLine, except those really are
// simple qty*price lines with no per-document variability, whereas
// Billing's LineItem already carries optional tax-mode/HSN/catalog-link
// fields that would need their own migration once printable documents
// need to read them structurally — left as Json for this pass.
// Billing Items (moduleSlug "billing-items") and Contacts (moduleSlug
// "billing-contacts") are NOT converted here — every document below
// still points at a contact/customer by loose display name/string
// (`contact`/`customerName`), same convention StockLot/MaterialConsumption
// already use for pointing at another BusinessRecord-backed catalog.
// ---------------------------------------------------------------------

/// The core sales document — GST or Non-GST. Mirrors billing.ts's real
/// BusinessRecord shape (billingColumns/billingFormFields) closely:
/// subtotal/taxAmount/discountAmount/roundOff/totalAmount/amountPaid/
/// amountDue, paymentStatus, paymentMode, invoiceSource. `contact` is a
/// loose display-name reference into billing-contacts (still
/// BusinessRecord, see note above), not a Prisma relation.
model Invoice {
  id             String    @id @default(cuid())
  partnerId      String
  invoiceNumber  String
  invoiceType    String    @default("GST") // GST | Non-GST
  contact        String?
  customerGstin  String?
  items          Json      @default("[]")
  issueDate      DateTime
  dueDate        DateTime?
  subtotal       Int       @default(0) // paise
  taxAmount      Int       @default(0) // paise
  discountAmount Int       @default(0) // paise
  roundOff       Int       @default(0) // paise
  totalAmount    Int       @default(0) // paise
  amountPaid     Int       @default(0) // paise
  amountDue      Int       @default(0) // paise
  /// Draft | Sent | Paid | Overdue | Partially Paid
  paymentStatus  String    @default("Draft")
  paymentMode    String?
  /// Service Centre | POS Sale | Direct — see billing.ts's INVOICE_SOURCE_OPTIONS.
  invoiceSource  String?
  notes          String?   @db.Text
  terms          String?   @db.Text
  createdAt      DateTime  @default(now())

  payments    Payment[]
  creditNotes CreditNote[]

  @@unique([partnerId, invoiceNumber])
  @@index([partnerId])
  @@index([partnerId, issueDate])
  @@map("invoices")
}

/// A payment recorded against an Invoice — separate row so an invoice can
/// carry multiple partial payments, matching billing-payments.ts's real
/// shape exactly (getInvoiceBalance sums these to compute balance).
model Payment {
  id        String   @id @default(cuid())
  partnerId String
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])
  contact   String?
  amount    Int // paise
  mode      String
  paidAt    DateTime
  reference String?
  createdAt DateTime @default(now())

  @@index([partnerId])
  @@index([invoiceId])
  @@map("payments")
}

/// Credit Note or Debit Note — same document shape, distinguished by
/// `noteType`, matching billing-credit-notes.ts's shared model exactly.
model CreditNote {
  id          String   @id @default(cuid())
  partnerId   String
  noteNumber  String
  noteType    String   @default("Credit Note") // Credit Note | Debit Note
  contact     String?
  invoiceId   String?
  invoice     Invoice? @relation(fields: [invoiceId], references: [id])
  reason      String?
  issueDate   DateTime
  subtotal    Int      @default(0) // paise
  taxAmount   Int      @default(0) // paise
  totalAmount Int      @default(0) // paise
  createdAt   DateTime @default(now())

  @@unique([partnerId, noteNumber])
  @@index([partnerId])
  @@index([invoiceId])
  @@map("credit_notes")
}

/// Matches billing-sales-documents.ts's shared quotation/challan/proforma
/// shape — this model covers Quotation specifically (validUntil, no
/// challan-only or proforma-only fields).
model Quotation {
  id              String    @id @default(cuid())
  partnerId       String
  quotationNumber String
  contact         String?
  items           Json      @default("[]")
  issueDate       DateTime
  validUntil      DateTime?
  subtotal        Int       @default(0) // paise
  taxAmount       Int       @default(0) // paise
  totalAmount     Int       @default(0) // paise
  /// Draft | Sent | Accepted | Rejected | Cancelled
  status          String    @default("Draft")
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())

  @@unique([partnerId, quotationNumber])
  @@index([partnerId])
  @@map("quotations")
}

/// Matches billing-sales-documents.ts's Delivery Challan shape (purpose,
/// vehicleNumber, dispatchAddress instead of Quotation's validUntil).
model DeliveryChallan {
  id              String   @id @default(cuid())
  partnerId       String
  challanNumber   String
  contact         String?
  items           Json     @default("[]")
  issueDate       DateTime
  purpose         String?
  vehicleNumber   String?
  dispatchAddress String?
  subtotal        Int      @default(0) // paise
  taxAmount       Int      @default(0) // paise
  totalAmount     Int      @default(0) // paise
  status          String   @default("Draft")
  notes           String?  @db.Text
  createdAt       DateTime @default(now())

  @@unique([partnerId, challanNumber])
  @@index([partnerId])
  @@map("delivery_challans")
}

/// Matches billing-sales-documents.ts's Proforma Invoice shape (same as
/// Quotation's validUntil + status/totals).
model ProformaInvoice {
  id             String    @id @default(cuid())
  partnerId      String
  proformaNumber String
  contact        String?
  items          Json      @default("[]")
  issueDate      DateTime
  validUntil     DateTime?
  subtotal       Int       @default(0) // paise
  taxAmount      Int       @default(0) // paise
  totalAmount    Int       @default(0) // paise
  status         String    @default("Draft")
  notes          String?   @db.Text
  createdAt      DateTime  @default(now())

  @@unique([partnerId, proformaNumber])
  @@index([partnerId])
  @@map("proforma_invoices")
}

/// Flat cash-out record — matches billing-expenses.ts exactly (ported
/// from AN-CRM's vendor Expenses page per that file's own doc comment).
model Expense {
  id              String   @id @default(cuid())
  partnerId       String
  expenseDate     DateTime
  category        String
  description     String?
  vendorName      String?
  paymentMode     String
  amount          Int // paise
  referenceNumber String?
  taxAmount       Int? // paise
  createdAt       DateTime @default(now())

  @@index([partnerId])
  @@index([partnerId, expenseDate])
  @@map("expenses")
}

/// Matches billing-recurring.ts's template shape — the cron route
/// (src/app/api/cron/billing-recurring-invoices/route.ts) creates a real
/// Invoice from any row whose nextRunDate has passed, then advances it
/// (see advanceNextRunDate) and stamps lastGeneratedInvoiceId.
model RecurringInvoiceSchedule {
  id                     String    @id @default(cuid())
  partnerId              String
  customer               String
  items                  Json      @default("[]")
  frequency              String // Weekly | Monthly | Quarterly | Yearly
  startDate              DateTime?
  nextRunDate            DateTime
  totalAmount            Int       @default(0) // paise
  /// Active | Paused
  status                 String    @default("Active")
  lastGeneratedInvoiceId String?
  createdAt              DateTime  @default(now())

  @@index([partnerId])
  @@map("recurring_invoice_schedules")
}

// ---------------------------------------------------------------------
// ==== Brand (multi-location hierarchy) ====
// IMPORTANT — POS/Location relationship: PosTillSession.locationId
// (prisma/schema.prisma above) already references a Brand > Location
// row's id, but ONLY as a loose string (no @relation), because Brand >
// Location has always lived in the generic BusinessRecord store (see
// brand.ts's own doc comment: "not a Prisma relation, since Brand/
// Location still lives in the generic BusinessRecord store"). Existing
// PosTillSession rows already carry BusinessRecord-style ids (e.g.
// "LOC-014") in that column. Introducing a REAL Location table now would
// mint new cuid ids that do NOT match those existing string values, so
// adding a hard FK today would either (a) silently orphan every existing
// PosTillSession.locationId, or (b) require a data-migration step
// backfilling/remapping ids — out of scope for a schema-only pass and
// exactly the kind of write CLAUDE.md says needs separate, explicit
// confirmation. Decision: Location.id below is a fresh cuid-keyed table;
// PosTillSession.locationId is DELIBERATELY LEFT AS-IS (loose string, no
// FK added) so POS is not broken. A future stage can add a nullable
// `locationRefId` FK column to PosTillSession alongside the existing
// loose field and backfill it — not done here.
// ---------------------------------------------------------------------

model Brand {
  id        String   @id @default(cuid())
  partnerId String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  locations Location[]

  @@index([partnerId])
  @@map("brands")
}

/// One location under a Brand. `partnerId` is the location's OWN partner
/// (brand.ts's sample data shows sibling locations under one Brand
/// belonging to different partners, e.g. "Meridian South Pvt Ltd" vs.
/// "Meridian West Pvt Ltd") — distinct from Brand.partnerId, which is the
/// brand-account owner. mappedWarehouseId stays a loose string (brand.ts's
/// mappedWarehouse already points at a BusinessRecord-backed warehouse
/// catalog, not a Prisma model).
model Location {
  id                String    @id @default(cuid())
  brandId           String
  brand             Brand     @relation(fields: [brandId], references: [id])
  partnerId         String
  locationName      String
  city              String
  modulesEnabled    String?
  mappedWarehouseId String?
  monthlyRevenue    Int       @default(0) // paise
  /// Active | Onboarding | Suspended
  status            String    @default("Onboarding")
  openedDate        DateTime?
  createdAt         DateTime  @default(now())

  @@index([brandId])
  @@index([partnerId])
  @@map("locations")
}

// ---------------------------------------------------------------------
// ==== Clinic ====
// ---------------------------------------------------------------------

model Patient {
  id                String   @id @default(cuid())
  partnerId         String
  name              String
  phone             String?
  email             String?
  insuranceProvider String?
  createdAt         DateTime @default(now())

  appointments Appointment[]

  @@index([partnerId])
  @@map("patients")
}

model Appointment {
  id                  String   @id @default(cuid())
  partnerId           String
  patientId           String
  patient             Patient  @relation(fields: [patientId], references: [id])
  doctor              String
  appointmentDateTime DateTime
  durationMinutes     Int      @default(30)
  diagnosis           String?
  consultationFee     Int      @default(0) // paise
  /// Scheduled | In consultation | Completed | No-show | Cancelled
  status              String   @default("Scheduled")
  /// Loose reference into Billing's Invoice once one is raised for this
  /// appointment — not a hard FK, same convention as other cross-module
  /// pointers in this pass (Billing stays its own independently-scoped
  /// module).
  invoiceId           String?
  createdAt           DateTime @default(now())

  prescriptions Prescription[]

  @@index([partnerId])
  @@index([patientId])
  @@map("appointments")
}

/// Tenant-scoped via its parent Appointment (no own partnerId).
model Prescription {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  notes         String      @db.Text
  createdAt     DateTime    @default(now())

  @@index([appointmentId])
  @@map("prescriptions")
}

// ---------------------------------------------------------------------
// ==== AMC / Field Service ====
// Distinct from the separate `field-force` module (Provider/Booking/
// JobAllocation etc. above) — this is the amc-field-service module's own
// namespace, matching amc-field-service.ts's real fields (SLA hours,
// contract renewal, technician check-in lat/lng).
// ---------------------------------------------------------------------

model AmcContract {
  id                String   @id @default(cuid())
  partnerId         String
  customer          String
  equipment         String
  contractStartDate DateTime
  contractEndDate   DateTime
  renewalTermMonths Int      @default(12)
  slaHours          Int      @default(24)
  contractValue     Int      @default(0) // paise
  /// Active | Renewed | Expired
  contractStatus    String   @default("Active")
  /// Loose self-referencing chain for a renewed contract's old/new id —
  /// kept as plain strings (not a Prisma self-relation) since a renewal
  /// creates a brand-new AmcContract row rather than mutating this one.
  renewedFromId     String?
  renewedToId       String?
  createdAt         DateTime @default(now())

  serviceVisits ServiceVisit[]

  @@index([partnerId])
  @@map("amc_contracts")
}

/// One dispatched service visit/request against an AmcContract — mirrors
/// amc-field-service.ts's serviceRequestRaisedAt/technicianId/assignedAt/
/// status/checkInLatitude/checkInLongitude fields, and is what
/// computeSlaBreach() in that file reads to decide SLA breach.
model ServiceVisit {
  id                     String      @id @default(cuid())
  contractId             String
  contract               AmcContract @relation(fields: [contractId], references: [id])
  partnerId              String
  serviceRequestRaisedAt DateTime?
  technicianId           String?
  technicianName         String?
  assignedAt             DateTime?
  /// Scheduled | Technician en route | Checked in | Completed | Overdue
  status                 String      @default("Scheduled")
  checkInLatitude        Float?
  checkInLongitude       Float?
  createdAt              DateTime    @default(now())

  @@index([contractId])
  @@index([partnerId])
  @@map("service_visits")
}

// ---------------------------------------------------------------------
// ==== Restaurant POS ====
// Deliberately namespaced Restaurant* — separate from POS's own
// PosAccount/PosStaff/PosTillSession/PosSale tables above, and from Brand
// > Location (restaurant-pos.ts's table list is a static string array
// today, restaurantTables, not backed by any per-partner record — this
// gives it a real one).
// ---------------------------------------------------------------------

model RestaurantTable {
  id          String  @id @default(cuid())
  partnerId   String
  tableNumber String
  isActive    Boolean @default(true)

  @@unique([partnerId, tableNumber])
  @@index([partnerId])
  @@map("restaurant_tables")
}

/// Matches restaurant-pos.ts's real RestaurantOrder domain type exactly
/// (lines/covers/status/subtotal/taxAmount/totalAmount/kotSentAt/
/// billedAt/cancelReason/invoiceIds) — `lines` (OrderLine[]) kept as Json,
/// same "don't over-normalize" call as Billing's `items`.
model RestaurantOrder {
  id           String    @id @default(cuid())
  partnerId    String
  tableNumber  String
  waiter       String?
  lines        Json      @default("[]")
  covers       Int       @default(1)
  /// Open | In kitchen | Served | Billed | Cancelled
  status       String    @default("Open")
  subtotal     Int       @default(0) // paise
  taxAmount    Int       @default(0) // paise
  totalAmount  Int       @default(0) // paise
  orderTime    DateTime  @default(now())
  kotSentAt    DateTime?
  billedAt     DateTime?
  cancelReason String?
  invoiceIds   Json      @default("[]")

  @@index([partnerId])
  @@index([partnerId, status])
  @@map("restaurant_orders")
}

// ---------------------------------------------------------------------
// ==== Subscriptions / Membership ====
// This is the business-module "Subscriptions" (a partner's own gym/club/
// coaching members) — NOT the platform's own Partner.subscriptionStatus/
// Plan/Offer/SubscriptionPayment system above, which is untouched.
// ---------------------------------------------------------------------

model SubscriptionPlan {
  id           String   @id @default(cuid())
  partnerId    String
  name         String
  /// Monthly | Quarterly | Yearly
  billingCycle String   @default("Monthly")
  planAmount   Int      @default(0) // paise
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  subscribers Subscriber[]

  @@index([partnerId])
  @@map("subscription_plans")
}

/// Matches subscriptions.ts's real Membership domain type (billingCycle/
/// nextBillingDate/frozenAt/resumeDate/checkIns/invoiceIds).
model Subscriber {
  id              String            @id @default(cuid())
  partnerId       String
  planId          String?
  plan            SubscriptionPlan? @relation(fields: [planId], references: [id])
  memberName      String
  billingCycle    String            @default("Monthly")
  planAmount      Int               @default(0) // paise
  startDate       DateTime?
  nextBillingDate DateTime?
  /// Active | Paused | Expired | Cancelled
  status          String            @default("Active")
  frozenAt        DateTime?
  resumeDate      DateTime?
  /// CheckIn[] ({ timestamp }) — kept as Json, an append-only log with no
  /// query need beyond "show recent check-ins" on the detail page.
  checkIns        Json              @default("[]")
  invoiceIds      Json              @default("[]")
  createdAt       DateTime          @default(now())

  @@index([partnerId])
  @@index([planId])
  @@map("subscribers")
}

// ---------------------------------------------------------------------
// ==== Real Estate ====
// ---------------------------------------------------------------------

model Property {
  id            String    @id @default(cuid())
  partnerId     String
  propertyType  String // Apartment | Villa | Plot | Commercial
  address       String
  latitude      Float?
  longitude     Float?
  price         Int       @default(0) // paise
  areaSqft      Int?
  bedrooms      Int?
  /// Available | Under Offer | Sold | Rented
  listingStatus String    @default("Available")
  agentName     String?
  siteVisitDate DateTime?
  createdAt     DateTime  @default(now())

  enquiries Enquiry[]

  @@index([partnerId])
  @@map("properties")
}

/// Matches real-estate.ts's RealEstateLifecycle (lead pipeline: stage/
/// agent/site-visit window/deal value/commission/closed-lost reason).
model Enquiry {
  id               String    @id @default(cuid())
  partnerId        String
  propertyId       String?
  property         Property? @relation(fields: [propertyId], references: [id])
  /// New | Site Visit Scheduled | Negotiation | Agreement Signed | Closed/Lost
  stage            String    @default("New")
  agentName        String?
  siteVisitStart   DateTime?
  siteVisitEnd     DateTime?
  dealValue        Int? // paise
  commissionPct    Int?
  commissionAmount Int? // paise
  closedLostReason String?
  createdAt        DateTime  @default(now())

  @@index([partnerId])
  @@index([propertyId])
  @@map("enquiries")
}

// ---------------------------------------------------------------------
// ==== Rentals ====
// ---------------------------------------------------------------------

model RentalAsset {
  id        String  @id @default(cuid())
  partnerId String
  assetName String
  isActive  Boolean @default(true)

  agreements RentalAgreement[]

  @@index([partnerId])
  @@map("rental_assets")
}

/// Matches rentals.ts's RentalsLifecycle (deposit/damage/refund/return
/// tracking) plus its base columns. assetId is nullable — an agreement
/// may be created before a matching RentalAsset row exists (rentals.ts's
/// own extractRentalsLifecycle falls back to assetName for double-booking
/// checks when there's no separate asset catalog entry).
model RentalAgreement {
  id               String       @id @default(cuid())
  partnerId        String
  assetId          String?
  asset            RentalAsset? @relation(fields: [assetId], references: [id])
  assetName        String
  renter           String
  bookingStart     DateTime
  bookingEnd       DateTime
  depositAmount    Int          @default(0) // paise
  rentalAmount     Int          @default(0) // paise
  damageCharge     Int? // paise
  refundableAmount Int? // paise
  returned         Boolean      @default(false)
  returnedAt       DateTime?
  returnNotes      String?
  latitude         Float?
  longitude        Float?
  /// Requested | Confirmed | Ongoing | Completed | Cancelled
  status           String       @default("Requested")
  createdAt        DateTime     @default(now())

  @@index([partnerId])
  @@index([assetId])
  @@map("rental_agreements")
}

// ---------------------------------------------------------------------
// ==== Logistics / Fleet ====
// ---------------------------------------------------------------------

model Vehicle {
  id            String  @id @default(cuid())
  partnerId     String
  vehicleNumber String
  isActive      Boolean @default(true)

  trips Trip[]

  @@unique([partnerId, vehicleNumber])
  @@index([partnerId])
  @@map("vehicles")
}

model Driver {
  id        String  @id @default(cuid())
  partnerId String
  name      String
  phone     String?
  isActive  Boolean @default(true)

  trips Trip[]

  @@index([partnerId])
  @@map("drivers")
}

/// The shipment/delivery record — matches logistics-fleet.ts's
/// LogisticsLifecycle exactly (delivery stage machine + lat/lng tracking +
/// failure/delivery details).
model Trip {
  id               String    @id @default(cuid())
  partnerId        String
  vehicleId        String?
  vehicle          Vehicle?  @relation(fields: [vehicleId], references: [id])
  driverId         String?
  driver           Driver?   @relation(fields: [driverId], references: [id])
  driverName       String?
  origin           String
  destination      String
  currentLatitude  Float?
  currentLongitude Float?
  deliveryEta      DateTime?
  /// Pending | Out for Delivery | Delivered | Failed
  deliveryStage    String    @default("Pending")
  assignedAt       DateTime?
  pendingAt        DateTime?
  outForDeliveryAt DateTime?
  deliveredAt      DateTime?
  failedAt         DateTime?
  failureReason    String?
  recipientName    String?
  deliveryNotes    String?
  createdAt        DateTime  @default(now())

  @@index([partnerId])
  @@index([vehicleId])
  @@index([driverId])
  @@map("trips")
}

// ---------------------------------------------------------------------
// ==== Salon / Spa ====
// ---------------------------------------------------------------------

model SalonService {
  id              String  @id @default(cuid())
  partnerId       String
  name            String
  durationMinutes Int     @default(30)
  price           Int     @default(0) // paise
  isActive        Boolean @default(true)

  appointments SalonAppointment[]

  @@index([partnerId])
  @@map("salon_services")
}

/// Matches salon-spa.ts exactly, including stylist commission fields.
/// `customer` stays a loose display-name string (no dedicated Salon
/// customer catalog exists in the current real fields).
model SalonAppointment {
  id                String        @id @default(cuid())
  partnerId         String
  customer          String
  serviceId         String?
  service           SalonService? @relation(fields: [serviceId], references: [id])
  serviceName       String
  stylist           String
  durationMinutes   Int           @default(30)
  price             Int           @default(0) // paise
  /// Booked | In Progress | Completed | Cancelled | No-show
  status            String        @default("Booked")
  appointmentDate   DateTime
  branch            String?
  commissionPercent Int?
  commissionAmount  Int? // paise
  invoiceId         String?
  createdAt         DateTime      @default(now())

  @@index([partnerId])
  @@index([serviceId])
  @@map("salon_appointments")
}

// ---------------------------------------------------------------------
// ==== Loyalty & Rewards ====
// Cross-cutting module usable across POS/Restaurant/Clinic/Subscriptions
// etc. (see loyalty-rewards.ts) — `enrolledModule` stays a plain string
// label, not a Prisma relation into any of those modules' own tables.
// ---------------------------------------------------------------------

model LoyaltyMember {
  id                   String    @id @default(cuid())
  partnerId            String
  customerName         String
  pointsBalance        Int       @default(0)
  lifetimePointsEarned Int       @default(0)
  /// Bronze | Silver | Gold | Platinum — derived by computeTier() in
  /// loyalty-rewards.ts from lifetimePointsEarned, stored here as the
  /// last-computed value rather than recomputed on every read.
  tier                 String    @default("Bronze")
  lastRedemption       DateTime?
  cashbackEarned       Int       @default(0) // paise
  enrolledModule       String?
  /// Active | Inactive
  status               String    @default("Active")
  createdAt            DateTime  @default(now())

  ledgerEntries PointsLedgerEntry[]

  @@index([partnerId])
  @@map("loyalty_members")
}

/// Tenant-scoped via its parent LoyaltyMember (no own partnerId) — mirrors
/// loyalty-rewards.ts's LoyaltyTransaction ({ type, points, amount?,
/// timestamp }), given a real row instead of a Json array entry so a
/// ledger can be queried/paginated later without a migration.
model PointsLedgerEntry {
  id        String        @id @default(cuid())
  memberId  String
  member    LoyaltyMember @relation(fields: [memberId], references: [id])
  /// Earn | Redeem
  type      String
  points    Int
  amount    Int? // paise — linked purchase amount, for Earn entries
  createdAt DateTime      @default(now())

  @@index([memberId])
  @@map("points_ledger_entries")
}

// ---------------------------------------------------------------------
// ==== POS ====
// NOTE (no new tables): POS already has real, dedicated tables
// (PosAccount/PosStaff/PosTillSession, defined earlier in this schema)
// but — confirmed by a prior audit — has NO PartnerType row, so it has
// never been an independently signup-able business type on its own
// (today it's only reachable as an add-on module under some other
// type's defaultModules). Writing that PartnerType row (idPrefix, e.g.
