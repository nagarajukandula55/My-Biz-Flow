# Copy to .env.local for local development. Never commit a real .env.local.
# See src/lib/env.ts — required vars are validated at startup, not silently
# left undefined until something breaks at runtime.
#
# See docs/DEPLOYMENT.md for the full Vercel go-live checklist (which of
# these are required-for-boot vs required-for-a-feature vs optional).

# --- Super Admin gate (stopgap, see src/lib/adminAuth.ts) ---
# A single shared password for all /admin and module admin/ routes. This is
# NOT per-user auth — anyone with this value has full Super Admin access.
SUPER_ADMIN_SECRET=

# --- SEO / canonical domain (see src/lib/seo.ts) ---
# The real production domain, used for canonical URLs, sitemap.ts,
# robots.ts, and OpenGraph/JSON-LD. Defaults to https://mybizflow.in if
# unset; override only for preview/staging deployments.
NEXT_PUBLIC_SITE_URL=https://mybizflow.in

# --- Partner session signing (see src/lib/partnerSession.ts) ---
# Signing secret for the partner session cookie (a JWT: partner id + expiry).
# Required — without it, partner login/session verification throws rather
# than falling back to an unsigned or hardcoded key. Generate a long random
# value, e.g. `openssl rand -hex 32`.
PARTNER_SESSION_SECRET=

# --- Database (Prisma + PostgreSQL) ---
# A standard Postgres connection string, used for normal app queries.
# For local dev against a locally running Postgres:
# postgresql://postgres:postgres@localhost:5432/mybizflow?schema=public
# After setting this, run `npx prisma migrate dev` to create the schema.
DATABASE_URL=
# Direct (unpooled) connection, used only for running migrations — see
# prisma/schema.prisma's `directUrl`. In production (Vercel + Neon) this is
# set automatically by the Neon integration. Locally, same value as
# DATABASE_URL is fine unless you're pointing at a pooled connection.
DATABASE_URL_UNPOOLED=

# --- central-api integration (see src/lib/centralApi.ts) ---
# Now wired: pushes captured vendor subscription payments into
# AN-Accounting's sales ingestion API. CENTRAL_API_URL is the full
# endpoint, e.g. https://your-an-accounting-app.vercel.app/api/external/sales
# CENTRAL_API_KEY is that business's key from AN-Accounting's own
# Settings -> Sales API page — sent as `Authorization: Bearer <key>`
# (not x-api-key). Both are optional: unset just skips the notify call
# (subscription activation and payment persistence here still work).
CENTRAL_API_URL=
CENTRAL_API_KEY=

# --- Razorpay (subscription payments — see src/lib/razorpay.ts) ---
# From the Razorpay dashboard (Settings -> API Keys). Optional: the app
# runs fine without these, only checkout/verify actually need them.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Same value as RAZORPAY_KEY_ID, exposed to the browser for the Checkout
# widget (Razorpay's key id is not secret, only KEY_SECRET is).
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# From the Razorpay dashboard (Settings -> Webhooks) if you register a
# webhook at /api/razorpay/webhook. Optional — the primary flow verifies
# payment via the Checkout success signature, not the webhook.
RAZORPAY_WEBHOOK_SECRET=

# --- Field Force SMS ping (see src/lib/sms.ts) ---
# Optional — job-offer notifications work in-app regardless; unset means
# sendSms() just logs instead of calling a vendor. Shown here as an MSG91
# shape; swap src/lib/sms.ts's fetch() body for a different vendor.
SMS_API_KEY=
SMS_SENDER_ID=

# --- Field Force standalone deployment (see src/middleware.ts) ---
# Set these ONLY on a separate Vercel project/domain (same repo+DB) meant to
# expose just one partner's Field Force Customer/Provider app — leave both
# unset on the main CRM deployment.
FIELD_FORCE_STANDALONE=
FIELD_FORCE_PARTNER_ID=

# --- Cloudinary (Service Centre photo/document uploads) ---
# Ported from AN-CRM, which stores job-sheet and agreement photos in
# Cloudinary. Service Centre's data model already has beforePhotos/
# afterPhotos/kycDocRef/agreementDocRef fields (see
# src/lib/sample-data/service-centre*.ts) with nowhere real to upload to —
# these three vars are only the placeholder for that. NOT implemented in
# this pass: no Cloudinary SDK is installed and no upload route exists yet;
# wiring the actual upload flow is a separate follow-up task. From the
# Cloudinary dashboard (Settings > API Keys).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Resend (transactional email) ---
# Ported from AN-CRM's RESEND_API_KEY / RESEND_FROM, used there for partner
# welcome emails and password-reset emails. My-Biz-Flow sends no email at
# all today (no Resend SDK installed, no mailer module) — this is only the
# placeholder for that follow-up, not a working integration yet.
# RESEND_FROM is the verified "From" address/domain in Resend.
RESEND_API_KEY=
RESEND_FROM=

# --- Web push (job/workorder notifications) ---
# Ported from AN-CRM's VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY / VAPID_SUBJECT
# / NEXT_PUBLIC_VAPID_PUBLIC_KEY, used there to push browser notifications
# for job/order updates. Would cover the same for Field Force job offers and
# Service Centre job-status changes here. Generate a keypair with
# `npx web-push generate-vapid-keys`. VAPID_SUBJECT is a mailto: or https:
# contact URL required by the push protocol. Not wired up in this pass — no
# web-push SDK installed yet; this is only the placeholder.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@mybizflow.in
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Platform legal entity (see src/lib/env.ts) ---
# The GST-registered legal entity that owns the "My Biz Flow" brand. Shown
# ONLY on My Biz Flow's own subscription billing documents (checkout,
# subscription invoices/receipts issued to partners for their platform
# usage) — never on Service Centre/Billing module invoices, which partners
# issue to their own customers. Optional: defaults to "AN Group" if unset.
# TODO(owner): confirm the exact registered legal name before relying on
# this for statutory documents.
PLATFORM_LEGAL_ENTITY_NAME=
